# Datenquelle der App: "mock" (alles im Browser, ohne Server) oder "pocketbase"
VITE_BACKEND=mock

# Nur bei VITE_BACKEND=pocketbase: Adresse Ihrer PocketBase
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# --- Nur für die Server-Seite, NICHT in dieser Datei speichern: ----------------
# PocketBase-Dienst (Umgebung des Dienstes):
#   TT_PASSWORT_SCHLUESSEL   genau 32 Zeichen, z. B. `openssl rand -hex 16`
# Einrichtung (setup.mjs), nur in der Shell setzen:
#   PB_URL  PB_SU_EMAIL  PB_SU_PASS
