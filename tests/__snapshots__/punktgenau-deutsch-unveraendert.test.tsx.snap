r31">0 XP</span><span data-hinweis-anker="tipp-r31" hidden=""></span></span><span class="relative inline-flex"><span tabindex="0" aria-describedby="tipp-r32">0 ★</span><span data-hinweis-anker="tipp-r32" hidden=""></span></span></span><span class="relative inline-flex"><div class="flex shrink-0 flex-col items-center gap-0.5" role="img" aria-label="Stufe 3 von 10 — passt sich deiner Sicherheit an. Etappe zu 0 Prozent gemeistert." aria-describedby="tipp-r3e" tabindex="0"><div class="relative" style="width: 36px; height: 36px;"><svg width="36" height="36" viewBox="0 0 36 36" class="-rotate-90"><circle cx="18" cy="18" r="16" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="4"></circle><circle cx="18" cy="18" r="16" fill="none" stroke="rgb(var(--c-accent))" stroke-width="4" stroke-linecap="round" stroke-dasharray="100.53096491487338" stroke-dashoffset="100.53096491487338" class="transition-all duration-500"></circle></svg><span class="absolute inset-0 flex items-center justify-center text-base font-bold text-ink">3</span></div><span class="text-[10px] font-medium uppercase tracking-wide text-ink-muted">Stufe</span></div><span data-hinweis-anker="tipp-r3e" hidden=""></span></span><span class="relative inline-flex"><button type="button" class="btn-secondary btn-toggle" aria-haspopup="dialog" aria-expanded="false" aria-describedby="tipp-r33">Abzeichen</button><span data-hinweis-anker="tipp-r33" hidden=""></span></span><span class="relative inline-flex"><div role="timer" tabindex="0" aria-describedby="tipp-r34" aria-label="Heute geübt: 0:00." class="flex shrink-0 items-center gap-1.5 rounded-lg border border-hairline bg-surface-sunken px-2 py-1"><span aria-hidden="true" class="text-xs text-ink-muted">Heute</span><span aria-hidden="true" class="font-mono text-sm font-semibold tabular-nums tracking-wide text-ink">0:00</span></div><span data-hinweis-anker="tipp-r34" hidden=""></span></span></div><div aria-hidden="true" class="hidden h-11 w-px shrink-0 self-center bg-hairline lg:block"></div><div role="radiogroup" aria-label="Übungsrichtung" class="flex items-center gap-1"><span class="relative inline-flex"><button type="button" role="radio" aria-checked="true" tabindex="0" aria-describedby="tipp-r35" class="btn-primary btn-toggle">Schreiben</button><span data-hinweis-anker="tipp-r35" hidden=""></span></span><span class="relative inline-flex"><button type="button" role="radio" aria-checked="false" tabindex="-1" aria-describedby="tipp-r36" class="btn-secondary btn-toggle">Lesen</button><span data-hinweis-anker="tipp-r36" hidden=""></span></span></div><div aria-hidden="true" class="hidden h-11 w-px shrink-0 self-center bg-hairline lg:block"></div><label class="flex min-w-0 flex-wrap items-center gap-1.5 text-sm font-medium text-ink"><span class="text-ink-muted">Schrift:</span><span class="relative inline-flex"><select aria-label="Brailleschriftsystem (Bereich) auswählen" aria-describedby="tipp-r37" class="min-w-0 max-w-[14rem] rounded-xl border border-hairline bg-surface-raised px-3 py-2 text-sm font-medium text-ink focus:border-accent"><option value="basis">Basisschrift</option><option value="voll">Vollschrift</option><option value="computer">Computer</option><option value="kurzschrift">Kurzschrift</option><option value="ueb">UEB (Englisch)</option></select><span data-hinweis-anker="tipp-r37" hidden=""></span></span></label><div aria-hidden="true" class="hidden h-11 w-px shrink-0 self-center bg-hairline lg:block"></div><div class="flex flex-wrap items-center gap-1"><span class="relative inline-flex"><button type="button" class="btn-secondary btn-toggle" aria-label="Vorige Etappe" aria-describedby="tipp-r38"><span aria-hidden="true">←</span></button><span data-hinweis-anker="tipp-r38" hidden=""></span></span><span class="relative inline-flex"><select aria-label="Kapitel (Etappe) auswählen — mit Pfeil rauf und runter blättern" aria-describedby="tipp-r39" class="order-first w-full max-w-[18rem] rounded-xl border border-hairline bg-surface-raised px-3 py-2 text-sm text-ink focus:border-accent sm:order-none sm:w-auto"><option value="0">Etappe 1: l, a, i, m</option><option value="1">Etappe 2: s, u, o</option><option value="2">Etappe 3: d, n, e</option><option value="3">Etappe 4: Finde das Zeichen</option><option value="4">Etappe 5: Große Anfangsbuchstaben</option><option value="5">Etappe 6: r, t, h</option><option value="6">Etappe 7: g, b, k</option><option value="7">Etappe 8: w, f, z</option><option value="8">Etappe 9: p, v, j</option><option value="9">Etappe 10: c, q, x, y</option><option value="10">Etappe 11: ä, ö, ü und ß</option><option value="11">Etappe 12: Alle Buchstaben gemischt</option><option value="12">Etappe 13: Punkt, Komma, Frage- und Ausrufezeichen</option><option value="13">Etappe 14: Mehr Satzzeichen: Doppelpunkt, Klammern &amp; Co.</option><option value="14">Etappe 15: Zahlen mit dem Zahlzeichen</option><option value="15">Etappe 16: Plus und Gleich</option><option value="16">Etappe 17: Minus</option><option value="17">Etappe 18: Mal</option><option value="18">Etappe 19: Ganze Texte lesen und schreiben</option></select><span data-hinweis-anker="tipp-r39" hidden=""></span></span><span class="relative inline-flex"><button type="button" class="btn-secondary btn-toggle" aria-label="Nächste Etappe" aria-describedby="tipp-r3a"><span aria-hidden="true">→</span></button><span data-hinweis-anker="tipp-r3a" hidden=""></span></span></div></div></div><div class="space-y-4"><details class="blatt-karte rounded-xl border border-accent/30 bg-accent-soft p-3" open=""><summary class="cursor-pointer text-sm font-semibold text-ink">Neue Zeichen in diesem Level: <span class="font-normal text-ink-soft">Lina = ⠨ l i n a</span></summary><p class="mb-3 mt-2 text-sm text-ink-soft">Im Braille gibt es kein eigenes großes A. Ein kleines Vorzeichen — Punkte 4 und 6 — kündigt einen Großbuchstaben an. So wird aus „lina“ der Name „Lina“. Wir üben das gleich mit echten Namen.</p><ul tabindex="-1" aria-label="Meine Tasten: neue Zeichen dieser Etappe" class="m-0 flex list-none flex-wrap gap-3 p-0 outline-none"><li class="rounded-xl border border-hairline bg-surface-sunken px-3 py-2"><div aria-hidden="true" class="flex flex-col items-center gap-1"><span class="text-3xl font-bold text-ink">Lina</span><div class="flex flex-wrap items-start gap-2 "><svg role="img" aria-label="Punkte 4, 6" data-zustand="neutral" viewBox="0 0 60 90" width="20" height="30"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle></svg><svg role="img" aria-label="Punkte 1, 2, 3" data-zustand="neutral" viewBox="0 0 60 90" width="20" height="30"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="Punkte 2, 4" data-zustand="neutral" viewBox="0 0 60 90" width="20" height="30"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="Punkte 1, 3, 4, 5" data-zustand="neutral" viewBox="0 0 60 90" width="20" height="30"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="Punkt 1" data-zustand="neutral" viewBox="0 0 60 90" width="20" height="30"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div></div><span class="sr-only">Lina: Punkte 4, 6, Punkte 1, 2, 3, Punkte 2, 4, Punkte 1, 3, 4, 5, Punkt 1 ⠨⠇⠊⠝⠁</span></li></ul></details><div class="space-y-2" data-aufgabe="schreiben-Nina"><p id=":r3c:" class="m-0 text-center text-sm text-ink-muted">Schreib in Braille:</p><div class="card rounded-2xl focus-within:ring-[4.5px] focus-within:ring-accent"><div class="relative px-4 py-3"><p class="m-0 text-center font-bold tracking-wide text-ink" style="font-size: 1.8rem; line-height: 1.1;" data-angabe="true" aria-describedby=":r3c:">Nina</p><div class="mt-2 flex justify-center sm:absolute sm:right-3 sm:top-1/2 sm:mt-0 sm:-translate-y-1/2 sm:justify-end"><span class="relative inline-flex"><div class="flex shrink-0 flex-col items-center gap-0.5"><div id="pl-round-ticks" role="img" tabindex="-1" aria-label="Runde: 0 von mindestens 12 Aufgaben geschafft, noch mindestens 12." aria-describedby="tipp-r3d" class="flex flex-col items-center gap-0.5 rounded-lg px-1 outline-none focus-visible:shadow-focus focus-visible:ring-[4.5px] focus-visible:ring-accent"><span aria-hidden="true" class="tt-ticks"><span class="tt-tick"></span><span class="tt-tick"></span><span class="tt-tick"></span><span class="tt-tick"></span><span class="tt-tick"></span><span class="tt-tick"></span><span class="tt-tick"></span><span class="tt-tick"></span><span class="tt-tick"></span><span class="tt-tick"></span><span class="tt-tick"></span><span class="tt-tick"></span></span><span aria-hidden="true" class="flex items-center gap-1 text-[10px] font-medium text-ink-muted"><span class="font-semibold text-ink">0/12</span><span class="uppercase tracking-wide">Runde</span></span></div></div><span data-hinweis-anker="tipp-r3d" hidden=""></span></span></div></div><p id=":r3b:" class="sr-only">Punkt-Tasten f d s und j k l gleichzeitig drücken und loslassen ergibt eine Zelle. Sitzt die Zelle, geht es von selbst weiter. Leertaste für die Lücke, Rücktaste löscht. Umschalt gedrückt halten sagt die nächste Zelle an.</p><div data-schreibflaeche="true" class="relative border-t border-hairline px-4 pb-4 pt-3 outline-none"><textarea class="sr-only" rows="1" wrap="off" aria-label="Braille-Eingabefeld" aria-describedby=":r3b:" aria-keyshortcuts="Backspace Space Shift" tabindex="0" data-feld="braillezellen" data-kuerzel="an" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off">Nina</textarea><div class="flex flex-wrap items-end justify-center gap-1.5"><div data-zelle="aktuell" class="rounded-lg p-1 transition-colors bg-accent-soft ring-1 ring-accent/50"><svg role="img" aria-label="aktuelle Zelle" data-zustand="pending" viewBox="0 0 60 90" width="26.666666666666664" height="40"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div><div class="rounded-lg p-1 transition-colors "><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="26.666666666666664" height="40"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><c