g:block"></div><div role="radiogroup" aria-label="Übungsrichtung" class="flex items-center gap-1"><span class="relative inline-flex"><button type="button" role="radio" aria-checked="false" tabindex="-1" aria-describedby="tipp-r41" class="btn-secondary btn-toggle">Schreiben</button><span data-hinweis-anker="tipp-r41" hidden=""></span></span><span class="relative inline-flex"><button type="button" role="radio" aria-checked="true" tabindex="0" aria-describedby="tipp-r42" class="btn-primary btn-toggle">Lesen</button><span data-hinweis-anker="tipp-r42" hidden=""></span></span></div><div aria-hidden="true" class="hidden h-11 w-px shrink-0 self-center bg-hairline lg:block"></div><label class="flex min-w-0 flex-wrap items-center gap-1.5 text-sm font-medium text-ink"><span class="text-ink-muted">Schrift:</span><span class="relative inline-flex"><select aria-label="Brailleschriftsystem (Bereich) auswählen" aria-describedby="tipp-r43" class="min-w-0 max-w-[14rem] rounded-xl border border-hairline bg-surface-raised px-3 py-2 text-sm font-medium text-ink focus:border-accent"><option value="basis">Basisschrift</option><option value="voll">Vollschrift</option><option value="computer">Computer</option><option value="kurzschrift">Kurzschrift</option><option value="ueb">UEB (Englisch)</option></select><span data-hinweis-anker="tipp-r43" hidden=""></span></span></label><div aria-hidden="true" class="hidden h-11 w-px shrink-0 self-center bg-hairline lg:block"></div><div class="flex flex-wrap items-center gap-1"><span class="relative inline-flex"><button type="button" class="btn-secondary btn-toggle" aria-label="Vorige Etappe" aria-describedby="tipp-r44"><span aria-hidden="true">←</span></button><span data-hinweis-anker="tipp-r44" hidden=""></span></span><span class="relative inline-flex"><select aria-label="Kapitel (Etappe) auswählen — mit Pfeil rauf und runter blättern" aria-describedby="tipp-r45" class="order-first w-full max-w-[18rem] rounded-xl border border-hairline bg-surface-raised px-3 py-2 text-sm text-ink focus:border-accent sm:order-none sm:w-auto"><option value="0">Etappe 1: l, a, i, m</option><option value="1">Etappe 2: s, u, o</option><option value="2">Etappe 3: d, n, e</option><option value="3">Etappe 4: Finde das Zeichen</option><option value="4">Etappe 5: Große Anfangsbuchstaben</option><option value="5">Etappe 6: r, t, h</option><option value="6">Etappe 7: g, b, k</option><option value="7">Etappe 8: w, f, z</option><option value="8">Etappe 9: p, v, j</option><option value="9">Etappe 10: c, q, x, y</option><option value="10">Etappe 11: ä, ö, ü und ß</option><option value="11">Etappe 12: Alle Buchstaben gemischt</option><option value="12">Etappe 13: Punkt, Komma, Frage- und Ausrufezeichen</option><option value="13">Etappe 14: Mehr Satzzeichen: Doppelpunkt, Klammern &amp; Co.</option><option value="14">Etappe 15: Zahlen mit dem Zahlzeichen</option><option value="15">Etappe 16: Plus und Gleich</option><option value="16">Etappe 17: Minus</option><option value="17">Etappe 18: Mal</option><option value="18">Etappe 19: Ganze Texte lesen und schreiben</option></select><span data-hinweis-anker="tipp-r45" hidden=""></span></span><span class="relative inline-flex"><button type="button" class="btn-secondary btn-toggle" aria-label="Nächste Etappe" aria-describedby="tipp-r46"><span aria-hidden="true">→</span></button><span data-hinweis-anker="tipp-r46" hidden=""></span></span></div></div></div><div class="space-y-4"><details class="blatt-karte rounded-xl border border-accent/30 bg-accent-soft p-3" open=""><summary class="cursor-pointer text-sm font-semibold text-ink">Neue Zeichen in diesem Level: <span class="font-normal text-ink-soft">c q x y</span></summary><p class="mb-3 mt-2 text-sm text-ink-soft">Die seltenen Buchstaben c, q, x und y. Damit schreibst du „Quark“, „Taxi“ und „Yoga“ — und kennst jetzt das ganze Alphabet.</p><ul tabindex="-1" aria-label="Meine Tasten: neue Zeichen dieser Etappe" class="m-0 flex list-none flex-wrap gap-3 p-0 outline-none"><li class="rounded-xl border border-hairline bg-surface-sunken px-3 py-2"><div aria-hidden="true" class="flex flex-col items-center gap-1"><span class="text-3xl font-bold text-ink">c</span><div class="flex flex-wrap items-start gap-2 "><svg role="img" aria-label="Punkte 1, 4" data-zustand="neutral" viewBox="0 0 60 90" width="20" height="30"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div></div><span class="sr-only">c: Punkte 1, 4 ⠉</span></li><li class="rounded-xl border border-hairline bg-surface-sunken px-3 py-2"><div aria-hidden="true" class="flex flex-col items-center gap-1"><span class="text-3xl font-bold text-ink">q</span><div class="flex flex-wrap items-start gap-2 "><svg role="img" aria-label="Punkte 1, 2, 3, 4, 5" data-zustand="neutral" viewBox="0 0 60 90" width="20" height="30"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stro