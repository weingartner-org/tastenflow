exports[`Deutsch bleibt gleich - die Seite ohne Probe-Schalter > die Bausteine einzeln: Stufenwahl, Wahl, Start > baustein-stufenwahl 1`] = `"<section class="space-y-3" aria-labelledby="plus-stufenwahl-titel"><h2 id="plus-stufenwahl-titel" tabindex="-1" class="text-xl font-semibold text-ink">Welche Stufe?</h2><p class="text-sm text-ink-muted">Ein Satz.</p><ul class="m-0 grid list-none gap-2 p-0 sm:grid-cols-2"><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink"><span class="font-medium">1. Schulstufe</span><span class="block text-sm text-ink-muted">bis 20; bis 100 nur mit Material</span></button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink"><span class="font-medium">2. Schulstufe</span><span class="block text-sm text-ink-muted">bis 100; bis 1000 nur mit Material</span></button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink"><span class="font-medium">3. Schulstufe</span><span class="block text-sm text-ink-muted">bis 1000</span></button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink"><span class="font-medium">4. Schulstufe</span><span class="block text-sm text-ink-muted">bis 1 000 000</span></button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink"><span class="font-medium">5. Schulstufe</span><span class="block text-sm text-ink-muted">natürliche Zahlen, Dezimalzahlen und Brüche, alle nicht negativ</span></button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink"><span class="font-medium">6. Schulstufe</span><span class="block text-sm text-ink-muted">Teiler und Vielfache, Brüche, ganze Zahlen, Prozent</span></button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink"><span class="font-medium">7. Schulstufe</span><span class="block text-sm text-ink-muted">rationale Zahlen mit Vorzeichen</span></button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink"><span class="font-medium">8. Schulstufe</span><span class="block text-sm text-ink-muted">reelle Zahlen</span></button></li></ul><button type="button" class="rounded border border-hairline px-3 py-2 text-ink">Zurück</button></section>"`;

exports[`Deutsch bleibt gleich - die Seite ohne Probe-Schalter > die Bausteine einzeln: Stufenwahl, Wahl, Start > baustein-wahl-stufe5-fest 1`] = `"<section class="space-y-3" aria-labelledby="plus-paketwahl"><h2 id="plus-paketwahl" tabindex="-1" class="text-xl font-semibold text-ink">5. Schulstufe - welche Übung?</h2><p class="text-sm text-ink-muted">Die 5. Schulstufe ordnet, was da ist: Vorrangregeln, Überschlag, Schranken - und führt das Rechnen mit Dezimalzahlen ein. Brüche werden dargestellt und verglichen, noch nicht berechnet.</p><ul class="m-0 list-none space-y-2 p-0"><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Stellenwert und Zahlenstrahl</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Runden und Schranken</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Vorrangregeln ohne Klammern</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Vorrangregeln mit Klammern</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Rechengesetze nutzen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Dezimalzahlen lesen und ordnen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Komma verschieben</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Plus und Minus mit Dezimalzahlen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Mal mit Dezimalzahlen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Geteilt mit Dezimalzahlen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Geteilt durch eine Dezimalzahl</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Runden von Dezimalzahlen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Arten von Brüchen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Erweitern und Kürzen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Brüche ordnen und vergleichen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Anteile und Bruchteile von Größen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Überschlag als Kontrolle</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Wie rechnest du das?</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Sachaufgaben mit Größen</button></li></ul><p class="text-sm text-ink-muted">Die Schulstufe stellt deine Lehrkraft ein.</p><div class="flex flex-wrap gap-2"></div></section>"`;

