focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 21v-1.5a5.5 5.5 0 0 1 5.5-5.5h4a5.5 5.5 0 0 1 5.5 5.5V21"></path></svg></button><span data-hinweis-anker="tipp-rl" hidden=""></span></span><span aria-hidden="true" class="mx-0.5 h-6 w-px shrink-0 self-center bg-hairline"></span><span class="relative inline-flex"><div class="relative inline-flex"><button type="button" aria-expanded="false" aria-controls="rd" aria-keyshortcuts="Alt+K" aria-describedby="tipp-rm" aria-label="Farben und Kontrast (Alt + K)" data-kopf-text="Farben und Kontrast" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border text-sm font-semibold transition-colors border-hairline bg-surface-raised text-ink hover:bg-surface-sunken"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[22px] w-[22px]" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor"></path></svg></button></div><span data-hinweis-anker="tipp-rm" hidden=""></span></span><span class="relative inline-flex"><div class="relative inline-flex"><button type="button" aria-expanded="false" aria-controls="re" aria-describedby="tipp-rn" aria-label="Klang und Vorlesen" data-kopf-text="Klang und Vorlesen" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border text-sm font-semibold transition-colors border-hairline bg-surface-raised text-ink hover:bg-surface-sunken"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[22px] w-[22px]" aria-hidden="true" focusable="false"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg></button></div><span data-hinweis-anker="tipp-rn" hidden=""></span></span></nav></header></div><p role="status" class="min-h-6 text-ink"></p><main class="pb-8"><section class="space-y-3" aria-labelledby="plus-paketwahl"><h2 id="plus-paketwahl" tabindex="-1" class="text-xl font-semibold text-ink">3. Schulstufe - welche Übung?</h2><p class="text-sm text-ink-muted">Das Einmaleins wird automatisiert, und zum ersten Mal kommen schriftliche Verfahren dazu. Entscheidend: das halbschriftliche Rechnen bricht danach erfahrungsgemäß ein - Plus hält es deshalb ausdrücklich weiter in Übung.</p><ul class="m-0 list-none space-y-2 p-0"><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Zahlenreihe bis 1000</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Zählen in Schritten bis 1000</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Ergänzen bis 1000</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">1000 teilen</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Halbschriftlich Plus bis 1000</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Halbschriftlich Minus bis 1000</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Vereinfachen und Hilfsaufgabe</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Runden auf Zehner und Hunderter</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Überschlag bei Plus und Minus</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Schriftlich Plus bis 1000</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Schriftlich Minus, Ergänzungsverfahren</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Schriftlich Minus, Abziehverfahren</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Probe durch Umkehraufgabe</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Einmaleins sicher</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Mal 10, durch 10, Zehner-Einmaleins</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Schriftlich Mal, einstelliger Multiplikator</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Division durch eine einstellige Zahl</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Division mit Rest</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Verdoppeln und Halbieren im Tausender</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Wie rechnest du das?</button></li><li><button type="button" class="w-full rounded border border-hairline px-3 py-2 text-left text-ink">Sachaufgaben bis 1000</button></li></ul><div class="flex flex-wrap gap-2"><button type="button" class="rounded border border-hairline px-3 py-2 text-ink">Andere Schulstufe</button><button type="button" class="rounded border border-hairline px-3 py-2 text-ink">Zurück</button></div></section></main><footer aria-label="Rechtliches" class="mt-10 text-center text-xs text-ink-muted"><a class="underline underline-offset-2" href="/datenschutz">Datenschutz</a> · <a class="underline underline-offset-2" href="/impressum">Impressum</a></footer></div></div>"`;

