exports[`Überblicksseiten: Deutsch bleibt gleich (Not-Aus =0) > lernwerkstatt > lernwerkstatt 1`] = `"<div class="min-h-screen"><header class="border-b border-hairline/60 px-4 py-3 sm:px-6 "><div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-3"><div class="flex items-center gap-1.5"><a aria-label="Sensorik Lernplattform, zur Startseite" class="shrink-0" href="/"><svg viewBox="0 0 64 64" class="h-10 w-10" aria-hidden="true" focusable="false"><defs><linearGradient id="sensorik-tiefe" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000000" stop-opacity="0"></stop><stop offset="0.55" stop-color="#000000" stop-opacity="0.05"></stop><stop offset="1" stop-color="#000000" stop-opacity="0.2"></stop></linearGradient></defs><rect x="0" y="0" width="64" height="64" rx="14.9" fill="#2C4C82"></rect><rect x="0" y="0" width="64" height="64" rx="14.9" fill="url(#sensorik-tiefe)"></rect><circle cx="24" cy="18" r="5" fill="#8BA3C7"></circle><circle cx="40" cy="18" r="5" fill="#F2F4F8"></circle><circle cx="24" cy="32" r="5" fill="#F2F4F8"></circle><circle cx="40" cy="32" r="5" fill="#8BA3C7"></circle><circle cx="24" cy="46" r="5" fill="#F2F4F8"></circle><circle cx="40" cy="46" r="5" fill="#8BA3C7"></circle></svg></a><a class="font-semibold leading-tight hover:underline underline-offset-2" href="/">Sensorik Lernplattform</a></div><div class="ml-auto flex flex-wrap items-center justify-end gap-2"><button type="button" class="btn-secondary btn-toggle btn-umriss" title="Hilfe zur Lernwerkstatt">Hilfe</button><a class="btn-secondary btn-toggle btn-umriss inline-flex items-center gap-1.5 whitespace-nowrap" href="/lernwerkstatt/konto"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 21v-1.5a5.5 5.5 0 0 1 5.5-5.5h4a5.5 5.5 0 0 1 5.5 5.5V21"></path></svg>Konto</a><select aria-label="Kontrast / Farbmodus" title="Kontrast und Farbmodus der gesamten Plattform" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink "><option value="hell">Hell (Standard)</option><option value="dunkel">Dunkel</option><option value="sw">Schwarz auf Weiß</option><option value="ws">Weiß auf Schwarz</option><option value="sg">Schwarz auf Gelb</option><option value="gs">Gelb auf Schwarz</option><option value="gb">Gelb auf Blau</option></select></div></div></header><div class="mx-auto w-full max-w-content px-4 pb-12 pt-6 sm:px-6"><section aria-labelledby="seitentitel" class="flex gap-5 border-b border-hairline py-7 sm:gap-7"><span aria-hidden="true" class="mt-1 inline-grid h-12 w-8 shrink-0 grid-flow-col grid-cols-2 grid-rows-3 gap-1.5"><span class="rounded-full bg-accent"></span><span class="rounded-full bg-accent"></span><span class="rounded-full bg-accent"></span><span class="rounded-full bg-ink-muted/25"></span><span class="rounded-full bg-ink-muted/25"></span><span class="rounded-full bg-ink-muted/25"></span></span><div class="min-w-0 flex-1"><h1 id="seitentitel" class="text-3xl font-semibold tracking-tight sm:text-4xl xl:text-[2.75rem]">Lernwerkstatt</h1><p class="mt-1 text-ink-muted sm:text-lg">Selbst üben mit Spielstand · für Kinder und Jugendliche · frei, ohne Anmeldung - du kannst sofort loslegen</p><ul class="mt-3 grid gap-x-8 gap-y-1 md:grid-cols-2"><li><a class="group block rounded-lg px-3 py-2 -mx-3 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/programme/tastenflow"><span class="flex gap-4"><span class="shrink-0"><svg viewBox="4 4 56 56" class="h-10 w-10" role="img" aria-label="Das Tastenflow-Zeichen: eine blaue Tastatur-Taste mit abgerundeten Ecken. Oben ein großes weißes T, darunter eine flache, unregelmäßige weiße Welle." focusable="false"><defs><linearGradient id="tastenflow-tiefe" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000000" stop-opacity="0"></stop><stop offset="0.55" stop-color="#000000" stop-opacity="0.05"></stop><stop offset="1" stop-color="#000000" stop-opacity="0.2"></stop></linearGradient></defs><rect x="4" y="4" width="56" height="56" rx="13" fill="#0072b2"></rect><rect x="4" y="4" width="56" height="56" rx="13" fill="url(#tastenflow-tiefe)"></rect><path d="M22.5 13 H41.5 A1.2 1.2 0 0 1 42.7 14.2 V17.3 A1.2 1.2 0 0 1 41.5 18.5 H35.1 V33.8 A1.2 1.2 0 0 1 33.9 35 H30.1 A1.2 1.2 0 0 1 28.9 33.8 V18.5 H22.5 A1.2 1.2 0 0 1 21.3 17.3 V14.2 A1.2 1.2 0 0 1 22.5 13 Z" fill="#FBFBFD"></path><path d="M12 46.5 C 13.3 45.8, 15.2 44.8, 17 44.8 C 19.5 44.8, 21.5 47.8, 24 47.8 C 27.5 47.8, 30 43.8, 34 43.8 C 38 43.8, 40.5 47.5, 44 47.5 C 47 47.5, 50.2 46.2, 52 45.5" stroke="#FBFBFD" stroke-width="5" fill="none" stroke-linecap="round"></path></svg></span><span class="min-w-0"><span class="font-semibold text-ink underline decoration-hairline underline-offset-4 group-hover:decoration-accent">Tastenflow</span><span class="text-sm text-ink-muted"> - Zehn-Finger-Schreiben</span> <span class="mt-1 block max-w-[62ch] text-sm text-ink-muted">Blind tippen Schritt für Schritt: von der Grundstellung bis zum ganzen Alphabet. Extrem vergrößerbar, mit Tönen und optionaler Sprachausgabe. Mit Lehrkräfte-Konto und Klassenansicht.</span></span></span></a></li><li><a class="group block rounded-lg px-3 py-2 -mx-3 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/programme/punktgenau"><span class="flex gap-4"><span class="shrink-0"><svg viewBox="4 4 56 56" class="h-10 w-10" role="img" aria-label="Das Zeichen von Punktgenau: eine purpurrote Taste mit abgerundeten Ecken. Darin ein großes weißes P; im senkrechten Strich des P liegen drei dunkelblaue Punkte untereinander, im Bogen ein vierter - zusammen die Braillepunkte des Buchstabens p." focusable="false" stroke-linejoin="round" stroke-linecap="round"><defs><linearGradient id="punktgenau-tiefe" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000000" stop-opacity="0"></stop><stop offset="0.55" stop-color="#000000" stop-opacity="0.05"></stop><stop offset="1" stop-color="#000000" stop-opacity="0.2"></stop></linearGradient></defs><rect x="4" y="4" width="56" height="56" rx="13" fill="#B04380"></rect><rect x="4" y="4" width="56" height="56" rx="13" fill="url(#punktgenau-tiefe)"></rect><path d="M20.80 17.27L30.41 17.27Q33.22 17.27 35.56 17.66Q37.91 18.05 39.61 19.09Q41.31 20.12 42.26 21.92Q43.20 23.71 43.20 26.56Q43.20 29.42 42.26 31.21Q41.31 33 39.61 34.02Q37.91 35.03 35.56 35.40Q33.22 35.76 30.41 35.76L25.12 35.76L25.12 47.95L20.80 47.95L20.80 17.27M25.12 20.91L25.12 32.04L30.78 32.04Q32.44 32.04 33.91 31.88Q35.38 31.72 36.46 31.16Q37.54 30.61 38.16 29.53Q38.78 28.45 38.78 26.56Q38.78 24.68 38.16 23.55Q37.54 22.42 36.46 21.85Q35.38 21.27 33.91 21.09Q32.44 20.91 30.78 20.91" fill="#FBFBFD" stroke="#FBFBFD" stroke-width="3.6"></path><rect x="26.3" y="20.3" width="11.3" height="10.5" fill="#FBFBFD"></rect><rect x="26.9" y="22.2" width="10.1" height="8" rx="3.2" fill="#B04380"></rect><circle cx="22.87" cy="19.34" r="2.5" fill="#B04380"></circle><circle cx="22.87" cy="32.64" r="2.5" fill="#B04380"></circle><circle cx="22.87" cy="45.93" r="2.5" fill="#B04380"></circle><circle cx="36.16" cy="19.34" r="2.5" fill="#B04380"></circle></svg></span><span class="min-w-0"><span class="font-semibold text-ink underline decoration-hairline underline-offset-4 group-hover:decoration-accent">Punktgenau</span><span class="text-sm text-ink-muted"> - Brailleschrift lernen</span> <span class="ml-1 inline-block whitespace-nowrap rounded-full px-2 py-0.5 align-middle text-xs font-semibold bg-warning-soft text-warning">Beta</span> <span class="mt-1 block max-w-[62ch] text-sm text-ink-muted">Die sechs Punkte Schritt für Schritt: von den ersten Buchstaben über die Vollschrift bis zu Kurzschrift und Computerbraille. Mit Tönen, riesiger Vergrößerung und Sprachausgabe. Mit Lehrkräfte-Konto und Klassenansicht.</span></span></span></a></li><li><a class="group block rounded-lg px-3 py-2 -mx-3 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/programme/klangpunkte"><span class="flex gap-4"><span class="shrink-0"><svg viewBox="4 4 56 56" class="h-10 w-10" role="img" aria-label="Das Zeichen von Klangpunkte: eine indigoblaue Taste mit abgerundeten Ecken. Darin links ein großes weißes K, in dessen senkrechtem Strich zwei dunkelblaue Punkte liegen - die Braillepunkte des Buchstabens k -, und rechts daneben ein weißer Violinschlüssel." focusable="false" stroke-linejoin="round" stroke-linecap="round"><defs><linearGradient id="klangpunkte-tiefe" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000000" stop-opacity="0"></stop><stop offset="0.55" stop-color="#000000" stop-opacity="0.05"></stop><stop offset="1" stop-color="#000000" stop-opacity="0.2"></stop></linearGradient></defs><rect x="4" y="4" width="56" height="56" rx="13" fill="#4B3B8F"></rect><rect x="4" y="4" width="56" height="56" rx="13" fill="url(#klangpunkte-tiefe)"></rect><path d="M15.94 45L12.18 45L12.18 18.28L15.94 18.28L15.94 31.72L27.98 18.28L32.66 18.28L22.46 29.44L33.82 45L29.22 45L19.94 32.20L15.94 36.60" fill="#FBFBFD" stroke="#FBFBFD" stroke-width="3.2"></path><rect x="10.6" y="16.68" width="6.9" height="29.92" rx="1.6" fill="#FBFBFD"></rect><circle cx="14.05" cy="20.08" r="2.3" fill="#4B3B8F"></circle><circle cx="14.05" cy="43.2" r="2.3" fill="#4B3B8F"></circle><g transform="translate(25.34 -47.43) scale(0.01033)"><path d="M 2002,7851 C 1941,7868 1886,7906 1835,7964 C 1784,8023 1759,8088 1759,8158 C 1759,8202 1774,8252 1803,8305 C 1832,8359 1876,8398 1933,8423 C 1952,8427 1961,8437 1961,8451 C 1961,8456 1954,8461 1937,8465 C 1846,8442 1771,8393 1713,8320 C 1655,8246 1625,8162 1623,8066 C 1626,7963