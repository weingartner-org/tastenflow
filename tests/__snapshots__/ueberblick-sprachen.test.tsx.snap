exports[`Überblicksseiten: Deutsch bleibt gleich (Not-Aus =0) > start > start 1`] = `"<div class="min-h-screen"><header class="border-b border-hairline/60 px-4 py-3 sm:px-6 "><div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-3"><div class="flex items-center gap-1.5"><a aria-label="Sensorik Lernplattform, zur Startseite" class="shrink-0" href="/"><svg viewBox="0 0 64 64" class="h-10 w-10" aria-hidden="true" focusable="false"><defs><linearGradient id="sensorik-tiefe" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000000" stop-opacity="0"></stop><stop offset="0.55" stop-color="#000000" stop-opacity="0.05"></stop><stop offset="1" stop-color="#000000" stop-opacity="0.2"></stop></linearGradient></defs><rect x="0" y="0" width="64" height="64" rx="14.9" fill="#2C4C82"></rect><rect x="0" y="0" width="64" height="64" rx="14.9" fill="url(#sensorik-tiefe)"></rect><circle cx="24" cy="18" r="5" fill="#8BA3C7"></circle><circle cx="40" cy="18" r="5" fill="#F2F4F8"></circle><circle cx="24" cy="32" r="5" fill="#F2F4F8"></circle><circle cx="40" cy="32" r="5" fill="#8BA3C7"></circle><circle cx="24" cy="46" r="5" fill="#F2F4F8"></circle><circle cx="40" cy="46" r="5" fill="#8BA3C7"></circle></svg></a><a class="font-semibold leading-tight hover:underline underline-offset-2" href="/">Sensorik Lernplattform</a></div><div class="ml-auto flex flex-wrap items-center justify-end gap-2"><span class="relative inline-flex"><button type="button" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-hairline bg-surface-raised text-ink transition-colors hover:bg-surface-sunken" aria-keyshortcuts="Alt+H" aria-label="Hilfe (Alt + H)" aria-describedby="tipp-r0"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[22px] w-[22px]" aria-hidden="true" focusable="false"><path d="M7.64 7.5a4.5