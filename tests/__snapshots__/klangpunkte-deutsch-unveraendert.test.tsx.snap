      ],
      "items": [Function],
      "legend": "",
      "levelId": "kp-haltebogen",
      "masteryGate": {
        "minAcc": 0.9,
        "minAttempts": 12,
        "patience": 0,
      },
      "system": "basis",
      "title": "Der Haltebogen",
    },
    {
      "id": "kp-auftakt",
      "introDu": "Nicht jeder Takt ist voll: Am Anfang darf ein kurzer Auftakt stehen, am Ende ein Resttakt. Und wenn die Zeile mitten im Takt endet, hilft der Musik-Bindestrich.",
      "introSie": "Teiltakte/Auftakt + Musik-Bindestrich (Krolick Kap. III/IX; De Garmo: incomplete measures): Taktrechnung als Hör- und Schreibübung.",
      "introducedUnits": [
        {
          "key": "hyphen",
          "spoken": "Musik-Bindestrich (der Takt geht auf der nächsten Zeile weiter)",
        },
      ],
      "items": [Function],
      "legend": "",
