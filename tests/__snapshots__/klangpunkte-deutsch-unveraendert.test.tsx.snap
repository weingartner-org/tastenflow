"75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle></svg><svg role="img" aria-label="Punkte 2, 6" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle></svg></div><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Terz und Sexte über dem Bass</button><button type="button" class="btn-secondary btn-toggle">2. Terz und Quinte über dem Bass</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-gesang im Runner (erste Aufgabe) > runner-kp-gesang 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Auf der Silbe „la“ — wie viele Töne singt die Stimme? (Mehrere Töne auf einer Silbe heißen Melisma.)"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Beim Singen gehören Töne und Silben zusammen: Mehrere Töne auf einer Silbe verbindet der Silben-Bindebogen, und Atemzeichen sagen, wo man Luft holt. Text- und Musikzeilen wechseln sich ab.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Auf der Silbe „la“ — wie viele Töne singt die Stimme? (Mehrere Töne auf einer Silbe heißen Melisma.)<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Einen Ton</button><button type="button" class="btn-secondary btn-toggle">2. Zwei Töne</button><button type="button" class="btn-secondary btn-toggle">3. Drei Töne</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-gitarre im Runner (erste Aufgabe) > runner-kp-gitarre 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Das Saitenzeichen (Punkte 1, 4, 6) und eine Ziffer sagen, auf welcher Saite gespielt wird. Welche Saite ist das?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Auf der Gitarre zählen Saite und Lage: Ein Saitenzeichen mit Ziffer sagt, welche Saite gezupft wird, das Lagenzeichen, wo die Hand greift. Und die Akkordsymbole (Kreis, Dreieck, kursive 7) verraten die Akkord-Sorte.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Das Saitenzeichen (Punkte 1, 4, 6) und eine Ziffer sagen, auf welcher Saite gespielt wird. Welche Saite ist das?<span class="text-ink-muted"></span></p><div class="flex flex-wrap items-center gap-1" aria-hidden="true"><svg role="img" aria-label="Punkte 1, 4, 6" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle></svg><svg role="img" aria-label="Punkte 1, 3" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. 2. Saite</button><button type="button" class="btn-secondary btn-toggle">2. 3. Saite</button><button type="button" class="btn-secondary btn-toggle">3. 1. Saite</button><button type="button" class="btn-secondary btn-toggle">4. 5. Saite</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-haltebogen im Runner (erste Aufgabe) > runner-kp-haltebogen 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Zwei halbe Noten auf demselben Ton. Einmal oder zweimal angeschlagen?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Zwei gleiche Noten, EIN langer Ton: Der Haltebogen bindet sie zusammen — die zweite wird nicht neu angeschlagen. In Braille sind das zwei Zellen direkt nach der Note.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Zwei halbe Noten auf demselben Ton. Einmal oder zweimal angeschlagen?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Einmal — gebunden (Haltebogen)</button><button type="button" class="btn-secondary btn-toggle">2. Zweimal — getrennt</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-inakkord im Runner (erste Aufgabe) > runner-kp-inakkord 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Zwei Stimmen: erst einzeln, dann zusammen. Welche Stimme lag oben?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Wie schreibt man zwei Stimmen in EINE Braille-Zeile? Das In-Accord-Zeichen trennt sie: erst die Oberstimme, dann das Zeichen, dann die Unterstimme — beide mit eigenem Oktavzeichen.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Zwei Stimmen: erst einzeln, dann zusammen. Welche Stimme lag oben?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Die erste (höhere) Stimme</button><button type="button" class="btn-secondary btn-toggle">2. Die zweite (tiefere) Stimme</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-instrumente im Runner (erste Aufgabe) > runner-kp-instrumente 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Welches Instrument spielt hier?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Klavier, Gitarre, Saxophon oder Querflöte — jedes klingt anders. Hör die Klangfarbe: Welches Instrument spielt? Sind zwei Motive vom selben oder von verschiedenen?</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Welches Instrument spielt hier?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Klavier</button><button type="button" class="btn-secondary btn-toggle">2. Gitarre</button><button type="button" class="btn-secondary btn-toggle">3. Querflöte</button><button type="button" class="btn-secondary btn-toggle">4. Saxophon</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-intervalle1 im Runner (erste Aufgabe) > runner-kp-intervalle1 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Zwei Töne nacheinander — wie weit liegen sie auseinander?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Zwei Töne — wie weit liegen sie auseinander? Erst der Kontrast von Prim, Quinte und Oktave, dann kommen die Terzen dazu. Merk dir die Kuckucks-Terz und die Amazing-Grace-Quarte.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Zwei Töne nacheinander — wie weit liegen sie auseinander?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Quinte (5 Stufen)</button><button type="button" class="btn-secondary btn-toggle">2. Oktave (8 Stufen)</button><button type="button" class="btn-secondary btn-toggle">3. Prim (1 Stufe)</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-intervalle2 im Runner (erste Aufgabe) > runner-kp-intervalle2 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-write-Schreib den Zweiklang von oben: die obere Note a und darunter das Zeichen für die Sexte. In der Oberstimme steht die OBERSTE Note, das Intervall zählt abwärts."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Jetzt schreibst du Zweiklänge: In der Oberstimme steht die OBERSTE Note, und das Intervallzeichen zählt abwärts. So bringt ein einziges Zeichen den zweiten Ton dazu.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Schreib den Zweiklang von oben: die obere Note a und darunter das Zeichen für die Sexte. In der Oberstimme steht die OBERSTE Note, das Intervall zählt abwärts.<span class="text-ink-muted"></span></p><div role="application" aria-label="Braille-Eingabe: f d s und j k l sind die Punkte, Leertaste der Taktstrich. Zelle 1 von 3. Umschalt gedrückt halten zeigt und sagt die Tasten der Zelle." aria-keyshortcuts="Shift" data-feld="notenschreiben" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><p class="text-sm text-ink-muted" aria-hidden="true">Schreib mit <span class="font-mono">f d s · j k l</span> — Zelle 1 von 3 · <kbd class="rounded border border-hairline px-1">⇧ Umschalt</kbd> zeigt die Zelle</p><div class="flex flex-wrap items-center gap-1.5" aria-hidden="true"><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-intervalle3 im Runner (erste Aufgabe) > runner-kp-intervalle3 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Zwei Töne abwärts — welches Intervall? (Sekunde und Septime reiben, die Quinte klingt offen.)"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Kür: Jetzt kommen die reibenden Intervalle dazu — Sekunde und Septime — und du schätzt, ob ein Klang größer oder kleiner als eine Quinte ist. Auf- und abwärts.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Zwei Töne abwärts — welches Intervall? (Sekunde und Septime reiben, die Quinte klingt offen.)<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Quinte</button><button type="button" class="btn-secondary btn-toggle">2. Sekunde</button><button type="button" class="btn-secondary btn-toggle">3. Septime</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-kadenzen im Runner (erste Aufgabe) > runner-kp-kadenzen 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Zwei Akkorde als Schluss — klingt das fertig oder geht es noch weiter?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Wie klingt ein Schluss? Bleibt die Musik offen (Halbschluss) oder kommt sie zur Ruhe (Ganzschluss)? Und ist es der starke Schluss von der Dominante oder der weiche „Amen“-Schluss?</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Zwei Akkorde als Schluss — klingt das fertig oder geht es noch weiter?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Fertig — ein richtiger Schluss</button><button type="button" class="btn-secondary btn-toggle">2. Offen — es geht noch weiter</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-klavier im Runner (erste Aufgabe) > runner-kp-klavier 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Zwei Zeilen - oben die rechte Hand (Violinschlüssel), unten die linke Hand (Bassschlüssel). Wie viele Töne spielt die LINKE Hand? Mit Alt + Q kannst du eine Hand allein groß sehen und hören."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Zwei Hände, zwei Zeichen: Die rechte Hand spielt meist die Melodie, die linke begleitet tiefer. Ein Hand-Zeichen am Zeilenanfang sagt, welche Hand dran ist — und das Pedal gibt den Klang mehr Fülle.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Zwei Zeilen - oben die rechte Hand (Violinschlüssel), unten die linke Hand (Bassschlüssel). Wie viele Töne spielt die LINKE Hand? Mit Alt + Q kannst du eine Hand allein groß sehen und hören.<span class="text-ink-muted"></span></p><div class="rounded-xl border border-hairline bg-surface-raised p-3"><div aria-hidden="true"><div class="flex items-stretch gap-2"><div class="w-1 shrink-0 self-stretch rounded-full bg-ink/60"></div><div class="min-w-0 flex-1 space-y-1"><div style="transition: opacity .2s, transform .2s; transform-origin: left center;"><p class="m-0 text-xs font-medium text-ink-muted">Rechte Hand · Violinschlüssel</p><svg aria-hidden="true" viewBox="0 0 180 127" style="width: 100%; max-width: 396.00000000000006px; height: auto; display: block;"><line x1="8" y1="26" x2="172" y2="26" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="36" x2="172" y2="36" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="46" x2="172" y2="46" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="56" x2="172" y2="56" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="66" x2="172" y2="66" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><path d="M 2002,7851 C 1941,7868 1886,7906 1835,7964 C 1784,8023 1759,8088 1759,8158 C 1759,8202 1774,8252 1803,8305 C 1832,8359 1876,8398 1933,8423 C 1952,8427 1961,8437 1961,8451 C 1961,8456 1954,8461 1937,8465 C 1846,8442 1771,8393 1713,8320 C 1655,8246 1625,8162 1623,8066 C 1626,7963 1657,7867 1716,7779 C 1776,7690 1853,7627 1947,7590 L 1878,7235 C 1724,7363 1599,7496 1502,7636 C 1405,7775 1355,7926 1351,8089 C 1353,8162 1368,8233 1396,8301 C 1424,8370 1466,8432 1522,8489 C 1635,8602 1782,8661 1961,8667 C 2022,8663 2087,8652 2157,8634 L 2002,7851 z M 2074,7841 L 2230,8610 C 2384,8548 2461,8413 2461,8207 C 2452,8138 2432,8076 2398,8021 C 2365,7965 2321,7921 2265,7889 C 2209,7857 2146,7841 2074,7841 z M 1869,6801 C 1902,6781 1940,6746 1981,6697 C 2022,6649 2062,6592 2100,6528 C 2139,6463 2170,6397 2193,6330 C 2216,6264 2227,6201 2227,6143 C 2227,6118 2225,6093 2220,6071 C 2216,6035 2205,6007 2186,5988 C 2167,5970 2143,5960 2113,5960 C 2053,5960 1999,5997 1951,6071 C 1914,6135 1883,6211 1861,6297 C 1838,6384 1825,6470 1823,6557 C 1828,6656 1844,6737 1869,68