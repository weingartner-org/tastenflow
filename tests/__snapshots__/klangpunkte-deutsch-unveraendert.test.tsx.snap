exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp1 im Runner (erste Aufgabe) > runner-kp1 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Drei Töne. Welcher war am höchsten?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Bevor wir Noten fühlen, üben wir das Wichtigste: genau hinhören. Höher oder tiefer, rauf oder runter — dein Ohr entscheidet.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Drei Töne. Welcher war am höchsten?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Der erste</button><button type="button" class="btn-secondary btn-toggle">2. Der zweite</button><button type="button" class="btn-secondary btn-toggle">3. Der dritte</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp2 im Runner (erste Aufgabe) > runner-kp2 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-tap-Hör den Rhythmus und klopf ihn mit der Leertaste nach — 3 Schläge."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Musik hat einen Herzschlag. Hör das Muster aus langen und kurzen Tönen und klopf es mit der Leertaste nach.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Hör den Rhythmus und klopf ihn mit der Leertaste nach — 3 Schläge.<span class="text-ink-muted"></span></p><div role="application" aria-label="Rhythmus klopfen: Leertaste. Bisher 0 Schläge." data-feld="klopfen" tabindex="0" class="rounded-xl border-2 border-dashed border-hairline p-6 text-center focus:border-accent"><p class="text-sm text-ink-muted" aria-hidden="true">Klopf hier mit der <strong>Leertaste</strong> — 0 von 3 Schlägen</p><button type="button" class="btn-primary btn-toggle mt-3">Klopfen (0 von 3)</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp3 im Runner (erste Aufgabe) > runner-kp3 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-write-Schreib: g — Achtelnote. (Die Grundform ist die Achtelnote.)"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Überraschung: Die Noten kennst du schon! c d e f g a h sind die Braille-Buchstaben d e f g h i j — das Alphabet, einen Schritt weitergerückt. Die Grundform ist die Achtelnote.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Schreib: g — Achtelnote. (Die Grundform ist die Achtelnote.)<span class="text-ink-muted"></span></p><div class="rounded-xl border border-hairline bg-surface-raised p-3"><svg aria-hidden="true" viewBox="0 0 90 127" style="width: 100%; max-width: 198.00000000000003px; height: auto; display: block;"><line x1="8" y1="26" x2="82" y2="26" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="36" x2="82" y2="36" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="46" x2="