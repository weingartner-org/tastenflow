ype="button" class="btn-secondary btn-toggle" aria-label="Voriges Kapitel"><span aria-hidden="true">←</span></button><select aria-label="Kapitel auswählen — mit Pfeil rauf und runter blättern" class="max-w-[18rem] rounded-xl border border-hairline bg-surface-raised px-3 py-2 text-sm text-ink focus:border-accent"><optgroup label="Klangwelt 1: Ohrenspitzer"><option value="kp1">Kapitel 1: Hoch oder tief? — Ohren auf</option><option value="kp2">Kapitel 2: Klopf den Rhythmus</option><option value="kp-puls">Kapitel 3: Puls-Fänger</option><option value="kp-lauschen-dauer">Kapitel 4: Lang oder kurz?</option><option value="kp-lauschen-dynamik">Kapitel 5: Laut und leise</option><option value="kp-instrumente">Kapitel 6: Welches Instrument?</option><option value="kp-echo">Kapitel 7: Echo-Spiel</option><option value="kp-melodie-memory">Kapitel 8: Melodie-Memory</option></optgroup><optgroup label="Klangwelt 2: Notenwerkstatt"><option value="kp3">Kapitel 1: Die Noten sind alte Bekannte</option><option value="kp4">Kapitel 2: Erste Melodien</option><option value="kp5">Kapitel 3: Viertelnoten — Punkt 6 dazu</option><option value="kp6">Kapitel 4: Halbe und Ganze</option><option value="kp7">Kapitel 5: Pausen und Takt</option><option value="kp8">Kapitel 6: Punktierte Noten</option><option value="kp-haltebogen">Kapitel 7: Der Haltebogen</option><option value="kp-auftakt">Kapitel 8: Auftakt und halbe Takte</option><option value="kp-pausen2">Kapitel 9: Lange Stille</option></optgroup><optgroup label="Klangwelt 3: Kreuz &amp; Lage"><option value="kp9">Kapitel 1: Kreuz, Be und Auflösung</option><option value="kp10">Kapitel 2: Oktavzeichen — die Lage</option><option value="kp11">Kapitel 3: Oktavzeichen — die Regeln</option><option value="kp12">Kapitel 4: Ganze oder Sechzehntel?</option><option value="kp-tonart">Kapitel 5: Die Tonart steht vorne dran</option><option value="kp-taktwechsel">Kapitel 6: Der Takt wechselt</option><option value="kp-schluessel">Kapitel 7: Schlüssel — nur fürs Wissen<