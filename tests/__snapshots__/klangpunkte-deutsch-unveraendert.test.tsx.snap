group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. 1 Be</button><button type="button" class="btn-secondary btn-toggle">2. 2 Bes</button><button type="button" class="btn-secondary btn-toggle">3. 3 Bes</button><button type="button" class="btn-secondary btn-toggle">4. 4 Bes</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-tonleitern im Runner (erste Aufgabe) > runner-kp-tonleitern 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-play-Spiel die C-Dur-Tonleiter aufwärts nach: c d e f g a h c — auf der Klaviatur D F G H J K L, dann Oktave rauf und noch einmal D."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Acht Stufen von einem Ton zum nächsten gleichen: die Tonleiter. Spiel die C-Dur-Leiter nach, hör den Unterschied zwischen Dur und Moll und finde die verrutschte Stufe.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Spiel die C-Dur-Tonleiter aufwärts nach: c d e f g a h c — auf der Klaviatur D F G H J K L, dann Oktave rauf und noch einmal D.<span class="text-ink-muted"></span></p><div role="application" aria-label="Nachspiel-Klaviatur: D F G H J K L sind c d e f g a h. Pfeil rauf und runter wechselt die Oktave. Ton 1 von 8. " data-feld="spielen" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><p class="text-sm text-ink-muted" aria-hidden="true">Spiel nach mit <span class="font-mono">D F G H J K L</span> — Ton 1 von 8 · <kbd class="rounded border border-hairline px-1">↑ ↓</kbd> Oktave (eingestrichene Oktave)</p><div class="flex flex-wrap gap-1.5" aria-hidden="true"><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">D</span><span class="text-xs text-ink-muted">c</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">F</span><span class="text-xs text-ink-muted">d</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">G</span><span class="text-xs text-ink-muted">e</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">H</span><span class="text-xs text-ink-muted">f</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">J</span><span class="text-xs text-ink-muted">g</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">K</span><span class="text-xs text-ink-muted">a</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">L</span><span class="text-xs text-ink-muted">h</span></button></div><div class="flex gap-1.5" aria-hidden="true"><button type="button" tabindex="-1" class="btn-secondary btn-toggle">Oktave rauf</button><button type="button" tabindex="-1" class="btn-secondary btn-toggle">Oktave runter</button></div></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-triolen im Runner (erste Aufgabe) > runner-kp-triolen 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Zwischen zwei ruhigen Schlägen: Wie viele Töne teilen sich EINEN Schlag — zwei oder drei?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Drei Töne teilen sich einen Schlag, wo sonst zwei wohnen: die Triole. In Braille steht ihr Zeichen (Punkte 2, 3) einmal vor der Gruppe.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Zwischen zwei ruhigen Schlägen: Wie viele Töne teilen sich EINEN Schlag — zwei oder drei?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Zwei — normale Achtel</button><button type="button" class="btn-secondary btn-toggle">2. Drei — eine Triole</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-verzierungen1 im Runner (erste Aufgabe) > runner-kp-verzierungen1 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Wurde der Ton verziert oder pur gespielt?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Kleine Ziertöne schmücken die Melodie: der Vorschlag (ein Ton davor) und der Triller (schnelles Wechseln). Ihre Zeichen stehen immer VOR der Note.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Wurde der Ton verziert oder pur gespielt?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Verziert</button><button type="button" class="btn-secondary btn-toggle">2. Pur — ohne Verzierung</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-verzierungen2 im Runner (erste Aufgabe) > runner-kp-verzierungen2 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Welche Verzierung hörst du?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Mehr Zierrat: der Doppelschlag windet sich um den Ton, Pralltriller und Mordent reißen ihn kurz an, das Tremolo lässt ihn schnell wiederholen. Merk dir, wo jedes Zeichen steht.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Welche Verzierung hörst du?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Doppelschlag — um den Ton herum</button><button type="button" class="btn-secondary btn-toggle">2. Pralltriller — kurz nach oben angerissen</button><button type="button" class="btn-secondary btn-toggle">3. Mordent — kurz nach unten angerissen</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-volten im Runner (erste Aufgabe) > runner-kp-volten 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Teil A steht zwischen Wiederholungszeichen, mit Haus 1 und Haus 2. In welcher Reihenfolge erklingt alles?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Wie liest man die Wegweiser der Form? Haus 1 und Haus 2 (die Volten) geben der Wiederholung einen neuen Schluss, Segno und Coda markieren Sprungziele, und „D.C.“ heißt: von vorn!</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Teil A steht zwischen Wiederholungszeichen, mit Haus 1 und Haus 2. In welcher Reihenfolge erklingt alles?<span class="text-ink-muted"></span></p><div class="flex flex-wrap items-center gap-1" aria-hidden="true"><svg role="img" aria-label="Punkte 1, 2, 6" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="10" fill="r