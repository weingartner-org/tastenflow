exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp5 im Runner (erste Aufgabe) > runner-kp5 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-write-Schreib: g — Viertelnote. (Viertel = Punkt 6 dazu — wie bei k bis t der Punkt 3.)"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Der Trick mit den Werten: Für eine Viertelnote kommt einfach Punkt 6 dazu — genau wie beim Alphabet aus a bis j die nächste Reihe wird. Gleiche Note, längerer Ton.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Schreib: g — Viertelnote. (Viertel = Punkt 6 dazu — wie bei k bis t der Punkt 3.)<span class="text-ink-muted"></span></p><div class="rounded-xl border border-hairline bg-surface-raised p-3"><svg aria-hidden="true" viewBox="0 0 90 127" style="width: 100%; max-width: 198.00000000000003px; height: auto; display: block;"><line x1="8" y1="26" x2="82" y2="26" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="36" x2="82" y2="36" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></