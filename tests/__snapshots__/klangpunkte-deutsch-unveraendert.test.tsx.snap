    {
      "id": "kp8",
      "introDu": "Ein Punkt macht die Note anderthalb mal so lang. In Braille bekommt er eine EIGENE Zelle: Punkt 3, direkt nach der Note.",
      "introSie": "Verlängerungspunkt als Folgezelle (Krolick Par. 1-2).",
      "introducedUnits": [
        {
          "key": "dot",
          "spoken": "Verlängerungspunkt (punktierte Note)",
