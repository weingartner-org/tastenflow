><option value="kp-spielwiese">Kapitel 7: Klang-Spielwiese</option><option value="kp-kadenzen">Kapitel 8: Schluss-Sache</option><option value="kp-komponier">Kapitel 9: Komponier-Werkstatt</option></optgroup><optgroup label="Klangwelt 8: Instrumentenkunde"><option value="kp-fingersatz">Kapitel 1: Fingersatz</option><option value="kp-klavier">Kapitel 2: Klaviermusik</option><option value="kp-gesang">Kapitel 3: Singen mit Braille</option><option value="kp-gitarre">Kapitel 4: Gitarre und Akkordsymbole</option><option value="kp-generalbass">Kapitel 5: Generalbass und Stufen</option><option value="kp-partitur">Kapitel 6: Partitur und Druckbild</option><option value="kp-orchester">Kapitel 7: Bläser, Schlagwerk &amp; Co.</option></optgroup><optgroup label="Klangwelt 9: Lieder-Bühne"><option value="kp14">Kapitel 1: Lieder-Werkstatt</option><option value="kp-lieder2">Kapitel 2: Lieder mit Ausdruck</option><option value="kp-lesekonzert">Kapitel 3: Lese-Konzert</option><option value="kp-liederquiz">Kapitel 4: Lieder-Quiz</option></optgroup></select><button type="button" class="btn-secondary btn-toggle" aria-label="Nächstes Kapitel"><span aria-hidden="true">→</span></button></div></div></div></div><div class="card p-4"><div class="flex flex-wrap items-center gap-2"><button type="button" aria-pressed="false" aria-keyshortcuts="Alt+U" class="btn-secondary btn-toggle" title="Alle Klangwelten und Kapitel mit deinem Sterne-Stand (Alt + U)"><span aria-hidden="true">🗺</span> Kapitelwahl</button><button type="button" aria-pressed="false" aria-keyshortcuts="Alt+L" class="btn-secondary btn-toggle" title="Liste aller Noten-Zeichen, sortiert nach deinem Lernweg (Alt + L)"><span aria-hidden="true">📖</span> Zeichenliste</button></div></div><div class="flex flex-wrap items-center gap-x-3 gap-y-2"><span class="text-sm font-medium text-ink-soft"><span aria-hidden="true">🔍 </span>Größe</span><div class="flex items-center gap-1"><button type="button" class="btn-secondary btn-toggle" aria-disabled=