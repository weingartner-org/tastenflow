exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-lieder2 im Runner (erste Aufgabe) > runner-kp-lieder2 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-„Morgen kommt der Weihnachtsmann“ — gebunden (legato) oder kurz (staccato) gespielt?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Dieselben Lieder, jetzt mit Gefühl: gebunden oder kurz, leise oder laut. Hör den Unterschied zwischen der trockenen und der ausdrucksvollen Fassung — und schreib die Zeilen mit.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">„Morgen kommt der Weihnachtsmann“ — gebunden (legato) oder kurz (staccato) gespielt?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Gebunden — legato</button><button type="button" class="btn-secondary btn-toggle">2. Kurz — staccato</button></div></div>"`;

