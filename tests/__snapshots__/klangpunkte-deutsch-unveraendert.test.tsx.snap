  "welten": [
    {
      "blurb": "Erst hören, dann nachspielen: Puls, Tonhöhen, Klangfarben und Echo mit den Ohren fangen.",
      "etappen": [
        {
          "id": "kp1",
          "introDu": "Bevor wir Noten fühlen, üben wir das Wichtigste: genau hinhören. Höher oder tiefer, rauf oder runter — dein Ohr entscheidet.",
          "title": "Hoch oder tief? — Ohren auf",
        },
        {
          "id": "kp2",
          "introDu": "Musik hat einen Herzschlag. Hör das Muster aus langen und kurzen Tönen und klopf es mit der Leertaste nach.",
          "title": "Klopf den Rhythmus",
        },
        {
          "id": "kp-puls",
          "introDu": "Jede Musik hat einen Herzschlag — den Grundschlag. Fang ihn: klopf ihn gleichmäßig mit, hör die betonten Schläge und unterscheide den Marsch (Zweier) vom Walzer (Dreier).",
          "title": "Puls-Fänger",
        },
        {
          "id": "kp-lauschen-dauer",
          "introDu": "Bevor du Notenwerte schreibst, hörst du sie: Welcher Ton klang länger? Wie viele Schläge dauerte er? Dein Ohr lernt Viertel, Halbe und Ganze als KLANG kennen.",
          "title": "Lang oder kurz?",
        },
        {
          "id": "kp-lauschen-dynamik",
          "introDu": "Musik lebt vom Wechsel zwischen laut und leise. Hör hin: laut oder leise? Wird es lauter oder leiser? Wo sitzt der betonte Ton? Das ist die Vorübung zur Dynamik in Braille.",
          "title": "Laut und leise",
        },
        {
          "id": "kp-instrumente",
          "introDu": "Klavier, Gitarre, Saxophon oder Querflöte — jedes klingt anders. Hör die Klangfarbe: Welches Instrument spielt? Sind zwei Motive vom selben oder von verschiedenen?",
          "title": "Welches Instrument?",
        },
        {
          "id": "kp-echo",
          "introDu": "Ich spiele, du spielst nach! Hör eine kleine Tonfolge und spiel sie auf der Klaviatur nach — D F G H J K L sind c d e f g a h. Nur die Töne zählen, der Rhythmus ist frei.",
          "title": "Echo-Spiel",
        },
        {
          "id": "kp-melodie-memory",
          "introDu": "Wie beim Memory, nur mit Tönen: Schaffst du die Folge, kommt ein Ton dazu. Wie weit kommst du? Ein Gedächtnis-Spiel fürs innere Ohr.",
          "title": "Melodie-Memory",
        },
      ],
      "key": "ohren",
      "nr": 1,
      "title": "Ohrenspitzer",
    },
    {
      "blurb": "Noten, Werte, Pausen und Takt — die Grundzeichen der Braille-Noten.",
      "etappen": [
        {
          "id": "kp3",
          "introDu": "Überraschung: Die Noten kennst du schon! c d e f g a h sind die Braille-Buchstaben d e f g h i j — das Alphabet, einen Schritt weitergerückt. Die Grundform ist die Achtelnote.",
          "title": "Die Noten sind alte Bekannte",
        },
        {
          "id": "kp4",
          "introDu": "Jetzt wird's Musik: kleine Melodien aus deinen neuen Noten — anhören, mitlesen, nachschreiben. Jede richtige Note klingt!",
          "title": "Erste Melodien",
        },
        {
          "id": "kp5",
          "introDu": "Der Trick mit den Werten: Für eine Viertelnote kommt einfach Punkt 6 dazu — genau wie beim Alphabet aus a bis j die nächste Reihe wird. Gleiche Note, längerer Ton.",
          "title": "Viertelnoten — Punkt 6 dazu",
        },
        {
          "id": "kp6",
          "introDu": "Punkt 3 dazu = halbe Note. Punkt 3 UND 6 = ganze Note. Damit kennst du alle vier Grundwerte — und hörst, wie verschieden lang sie klingen.",
          "title": "Halbe und Ganze",
        },
        {
          "id": "kp7",
          "introDu": "Auch Stille ist Musik: die vier Pausen. Und das Verrückteste an Braille-Noten: Der Taktstrich ist einfach die Leertaste!",
          "title": "Pausen und Takt",
        },
        {
          "id": "kp8",
          "introDu": "Ein Punkt macht die Note anderthalb mal so lang. In Braille bekommt er eine EIGENE Zelle: Punkt 3, direkt nach der Note.",
          "title": "Punktierte Noten",
        },
        {
          "id": "kp-haltebogen",
          "introDu": "Zwei gleiche Noten, EIN langer Ton: Der Haltebogen bindet sie zusammen — die zweite wird nicht neu angeschlagen. In Braille sind das zwei Zellen direkt nach der Note.",
          "title": "Der Haltebogen",
        },
        {
          "id": "kp-auftakt",
          "introDu": "Nicht jeder Takt ist voll: Am Anfang darf ein kurzer Auftakt stehen, am Ende ein Resttakt. Und wenn die Zeile mitten im Takt endet, hilft der Musik-Bindestrich.",
          "title": "Auftakt und halbe Takte",
        },
        {
          "id": "kp-pausen2",
          "introDu": "Wenn viele Takte still sind, zählt Braille schlau: bis drei leere Takte einfach die ganze Pause mehrmals — ab vier steht die Anzahl als Zahl davor.",
          "title": "Lange Stille",
        },
      ],
      "key": "werkstatt",
      "nr": 2,
      "title": "Notenwerkstatt",
    },
    {
      "blurb": "Versetzungszeichen, Tonarten, Oktavzeichen — und flinke kleine Werte.",
      "etappen": [
        {
          "id": "kp9",
          "introDu": "Manchmal rückt ein Ton einen halben Schritt: Kreuz macht höher, Be macht tiefer, das Auflösungszeichen macht es rückgängig. Das Zeichen steht direkt VOR der Note.",
          "title": "Kreuz, Be und Auflösung",
        },
        {
          "id": "kp10",
          "introDu": "In Braille gibt es keinen Notenschlüssel! Stattdessen sagen Oktavzeichen, WIE hoch eine Note liegt. Die erste Note eines Stücks bekommt immer eins.",
          "title": "Oktavzeichen — die Lage",
        },
        {
          "id": "kp11",
          "introDu": "Wann braucht eine Note ein Oktavzeichen? Sekunde und Terz: nie. Quarte und Quinte: nur bei Oktavwechsel. Ab der Sexte: immer. Werde zum Oktav-Detektiv!",
          "title": "Oktavzeichen — die Regeln",
        },
        {
          "id": "kp12",
          "introDu": "Ein Geheimnis der Braille-Noten: Dieselbe Zelle kann ganze Note ODER Sechzehntel bedeuten! Der Takt verrät dir, was gemeint ist. Detektivarbeit!",
          "title": "Ganze oder Sechzehntel?",
        },
        {
          "id": "kp-tonart",
          "introDu": "Kreuze oder Bes ganz am Anfang gelten fürs GANZE Stück: die Vorzeichnung. Bis drei wird das Zeichen wiederholt, ab vier steht eine Zahl davor — und dahinter kommt gleich die Taktangabe.",
          "title": "Die Tonart steht vorne dran",
        },
        {
          "id": "kp-taktwechsel",
          "introDu": "Mitten im Stück kann eine neue Taktangabe stehen — ab da wird anders gezählt. Dazu zwei Sonderzeichen: das C (Viervierteltakt) und alla breve (Zweihalbetakt).",
          "title": "Der Takt wechselt",
        },
        {
          "id": "kp-schluessel",
          "introDu": "Violinschlüssel und Bassschlüssel gibt es auch in Braille — aber nur als Info über das Druckbild! Die Lage sagen dir immer die Oktavzeichen. Gut zu kennen für Gespräche mit sehenden Musiker:innen und für MuseScore.",
          "title": "Schlüssel — nur fürs Wissen",
        },
        {
          "id": "kp-sechzehntel",
          "introDu": "Sechzehntel nutzen DIESELBE Zelle wie die ganze Note — den Trick kennst du aus „Ganze oder Sechzehntel?“. Neu: In Gruppen trägt nur die ERSTE Note die Wert-Punkte, der Rest sieht aus wie Achtel.",
          "title": "Flinke Sechzehntel",
        },
        {
          "id": "kp-triolen",
          "introDu": "Drei Töne teilen sich einen Schlag, wo sonst zwei wohnen: die Triole. In Braille steht ihr Zeichen (Punkte 2, 3) einmal vor der Gruppe.",
          "title": "Triolen und krumme Gruppen",
        },
      ],
      "key": "lage",
      "nr": 3,
      "title": "Kreuz & Lage",
    },
    {
      "blurb": "Bögen, Artikulation, Dynamik, Tempo und Verzierungen — Musik mit Gefühl.",
      "etappen": [
        {
          "id": "kp-bindebogen",
          "introDu": "Der Bindebogen sagt: spiel diese Töne weich gebunden, legato. Nicht zu verwechseln mit dem Haltebogen! Der bindet gleiche Töne zu EINEM — der Bindebogen verbindet verschiedene.",
          "title": "Der Bindebogen (Legato)",
        },
        {
          "id": "kp-artikulation",
          "introDu": "Wie wird ein Ton angeschlagen? Kurz abgesetzt (staccato), voll gehalten (tenuto) oder betont (Akzent)? Diese Zeichen stehen VOR der Note — nur die Fermate, die den Schluss anhält, steht danach.",
          "title": "Staccato, Akzent & Co.",
        },
        {
          "id": "kp-dynamik",
          "introDu": "Jetzt bekommt die Lautstärke ihre Zeichen: Vor jedem Vortragswort steht das Wortzeichen (Punkte 3, 4, 5), dann folgen f (forte), p (piano) und Co. Und die Gabeln zeigen crescendo und decrescendo.",
          "title": "Laut und leise in Braille",
        },
        {
          "id": "kp-tempo",
          "introDu": "Largo, Andante, Presto — die Tempowörter sagen, wie schnell gespielt wird. Hör sie, lern ihre Bedeutung, und schreib die genaue Metronomangabe „Viertel gleich 60“.",
          "title": "Tempo-Wörter und Metronom",
        },
        {
          "id": "kp-verzierungen1",
          "introDu": "Kleine Ziertöne schmücken die Melodie: der Vorschlag (ein Ton davor) und der Triller (schnelles Wechseln). Ihre Zeichen stehen immer VOR der Note.",
          "title": "Verzierungen I — Vorschlag und Triller",
        },
        {
          "id": "kp-verzierungen2",
          "introDu": "Mehr Zierrat: der Doppelschlag windet sich um den Ton, Pralltriller und Mordent reißen ihn kurz an, das Tremolo lässt ihn schnell wiederholen. Merk dir, wo jedes Zeichen steht.",
          "title": "Verzierungen II — Doppelschlag, Mordent, Tremolo",
        },
        {
          "id": "kp-ausdruck-lied",
          "introDu": "Jetzt bringst du alles zusammen: Nimm den Anfang eines echten Lieds und hör oder schreib ihn MIT Ausdruck — mal gebunden, mal kurz, mal mit einem Vortragswort davor. So klingt Musik lebendig.",
          "title": "Mit Gefühl! — im Lied",
        },
      ],
      "key": "ausdruck",
      "nr": 4,
      "title": "Ausdruck",
    },
    {
      "blurb": "Wiederholungen, Volten und Formen — Braille kürzt schlau, das Ohr hört den Bauplan.",
      "etappen": [
        {
          "id": "kp13",
          "introDu": "Musik wiederholt sich gern — und Braille kürzt schlau: ein eigenes Zeichen sagt: diesen Takt noch einmal! Dazu: Wiederholungsklammern und der Schlussstrich.",
          "title": "Wiederholung und Form",
        },
        {
          "id": "kp-braillerepeats",
          "introDu": "Braille ist schlau: Statt einen gleichen Takt noch einmal zu schreiben, setzt es das Simile-Zeichen — und mit einer Zahl dahinter sagt es sogar, wie oft. Aber Achtung: nicht auf dem ersten Schlag einer Zeile!",
          "title": "Braille spart Arbeit",
        },
        {
          "id": "kp-volten",
          "introDu": "Wie liest man die Wegweiser der Form? Haus 1 und Haus 2 (die Volten) geben der Wiederholung einen neuen Schluss, Segno und Coda markieren Sprungziele, und „D.C.“ heißt: von vorn!",
          "title": "Volten, Da Capo und Segno",
        },
        {
          "id": "kp-formen",
          "introDu": "Musik hat Baupläne: Kommt der Anfang wieder (A-B-A)? Wie oft kehrt der Kehrvers im Rondo zurück? Ist die Wiederholung genau — oder eine Variation? Hör die Form.",
          "title": "Formen hören",
        },
      ],
      "key": "form",
      "nr": 5,
      "title": "Formenbau",
    },
    {
      "blurb": "Zwei und mehr Töne zugleich: Intervalle hören und schreiben, Dur und Moll, zwei Stimmen in einer Zeile.",
      "etappen": [
        {
          "id": "kp-intervalle1",
          "introDu": "Zwei Töne — wie weit liegen sie auseinander? Erst der Kontrast von Prim, Quinte und Oktave, dann kommen die Terzen dazu. Merk dir die Kuckucks-Terz und die Amazing-Grace-Quarte.",
          "title": "Intervalle hören I",
        },
        {
          "id": "kp-intervalle2",
          "introDu": "Jetzt schreibst du Zweiklänge: In der Oberstimme steht die OBERSTE Note, und das Intervallzeichen zählt abwärts. So bringt ein einziges Zeichen den zweiten Ton dazu.",
          "title": "Intervalle in Braille",
        },
        {
          "id": "kp-intervalle3",
          "introDu": "Kür: Jetzt kommen die reibenden Intervalle dazu — Sekunde und Septime — und du schätzt, ob ein Klang größer oder kleiner als eine Quinte ist. Auf- und abwärts.",
          "title": "Intervalle hören II",
        },
        {
          "id": "kp-akkorde1",
          "introDu": "Drei Töne zusammen sind ein Dreiklang. Klingt er hell (Dur) oder dunkel (Moll)? Und kommen die Töne einzeln (gebrochen) oder alle zugleich? Dein Ohr lernt die Farbe der Akkorde.",
          "title": "Dur oder Moll?",
        },
        {
          "id": "kp-akkorde2",
          "introDu": "Einen Dreiklang schreibst du wie einen Zweiklang: die oberste Note, dann die Intervallzeichen für Terz und Quinte abwärts. Ein Ton, zwei Zeichen — fertig ist der Akkord.",
          "title": "Akkorde schreiben",
        },
        {
          "id": "kp-inakkord",
          "introDu": "Wie schreibt man zwei Stimmen in EINE Braille-Zeile? Das In-Accord-Zeichen trennt sie: erst die Oberstimme, dann das Zeichen, dann die Unterstimme — beide mit eigenem Oktavzeichen.",
          "title": "Zwei Stimmen, eine Zeile",
        },
      ],
      "key": "zusammenklang",
      "nr": 6,
      "title": "Zusammenklang",
    },
    {
      "blurb": "Tonleitern, Quintenzirkel, Diktate und eigene Takte — Musiktheorie zum Ausprobieren, mit Spielwiese und Komponier-Werkstatt.",
      "etappen": [
        {
          "id": "kp-tonleitern",
          "introDu": "Acht Stufen von einem Ton zum nächsten gleichen: die Tonleiter. Spiel die C-Dur-Leiter nach, hör den Unterschied zwischen Dur und Moll und finde die verrutschte Stufe.",
          "title": "Tonleitern",
        },
        {
          "id": "kp-quintenzirkel",
          "introDu": "Eine Rallye durch die Tonarten: Wie viele Kreuze hat G-Dur? Welche Tonart hat zwei Bes? Lern die Vorzeichen bis vier Kreuze und vier Bes — vorwärts und rückwärts.",
          "title": "Quintenzirkel-Rallye",
        },
        {
          "id": "kp-rhythmusdiktat",
          "introDu": "Ich klopfe einen Takt — du schreibst die Werte auf. Nur der Rhythmus zählt, die Tonhöhe bleibt gleich. Und umgekehrt: lies einen Rhythmus vom Blatt und klopf ihn nach.",
          "title": "Rhythmus-Diktat",
        },
        {
          "id": "kp-melodiediktat",
          "introDu": "Die Königsübung: Ich spiele eine kleine Melodie, du schreibst sie auf. Sie geht in kleinen Schritten los, der Startton wird immer gesagt, und du darfst so oft anhören, wie du willst.",
          "title": "Melodie-Diktat",
        },
        {
          "id": "kp-detektiv",
          "introDu": "Sei ein Korrektur-Detektiv: Lies die Braille-Zeile und hör die Aufnahme. An genau einer Stelle weicht der Klang von den Noten ab — oder alles stimmt. Findest du die Stelle?",
          "title": "Fehler-Detektiv",
        },
        {
          "id": "kp-baumeister",
          "introDu": "Bau eigene Takte: Schreib Noten und Pausen, bis die Schläge genau zur Taktart passen. Zu wenig? Zu viel? Dein Takt sagt es dir — und wenn er stimmt, klingt er.",
          "title": "Takt-Baumeister",
        },
        {
          "id": "kp-spielwiese",
          "introDu": "Freies Spiel über einem leisen Bordun: Mit den Pentatonik-Tasten kann kein Ton falsch klingen. Erzähl eine kleine Geschichte — mal leise, mal laut. Einfach ausprobieren.",
          "title": "Klang-Spielwiese",
        },
        {
          "id": "kp-kadenzen",
          "introDu": "Wie klingt ein Schluss? Bleibt die Musik offen (Halbschluss) oder kommt sie zur Ruhe (Ganzschluss)? Und ist es der starke Schluss von der Dominante oder der weiche „Amen“-Schluss?",
          "title": "Schluss-Sache",
        },
        {
          "id": "kp-komponier",
          "introDu": "Dein eigenes Blatt: Schreib frei, hör dir dein Werk an und speichere es. Bis zu fünf Werke passen ins Regal. Die Werkstatt ist besucht, sobald du das erste gespeichert hast.",
          "title": "Komponier-Werkstatt",
        },
      ],
      "key": "spielplatz",
      "nr": 7,
      "title": "Theorie-Spielplatz",
    },
    {
      "blurb": "Wie Instrumente notiert werden: Fingersatz, zwei Hände am Klavier, Singen mit Braille, Gitarre, Generalbass und der Aufbau einer Partitur.",
      "etappen": [
        {
          "id": "kp-fingersatz",
          "introDu": "Welcher Finger spielt welche Note? Die kleine Ziffer NACH der Note sagt es: 1 ist der Daumen, 5 der kleine Finger. So weiß die Hand immer, wohin.",
          "title": "Fingersatz",
        },
        {
          "id": "kp-klavier",
          "introDu": "Zwei Hände, zwei Zeichen: Die rechte Hand spielt meist die Melodie, die linke begleitet tiefer. Ein Hand-Zeichen am Zeilenanfang sagt, welche Hand dran ist — und das Pedal gibt den Klang mehr Fülle.",
          "title": "Klaviermusik",
        },
        {
          "id": "kp-gesang",
          "introDu": "Beim Singen gehören Töne und Silben zusammen: Mehrere Töne auf einer Silbe verbindet der Silben-Bindebogen, und Atemzeichen sagen, wo man Luft holt. Text- und Musikzeilen wechseln sich ab.",
          "title": "Singen mit Braille",
        },
        {
          "id": "kp-gitarre",
          "introDu": "Auf der Gitarre zählen Saite und Lage: Ein Saitenzeichen mit Ziffer sagt, welche Saite gezupft wird, das Lagenzeichen, wo die Hand greift. Und die Akkordsymbole (Kreis, Dreieck, kursive 7) verraten die Akkord-Sorte.",
          "title": "Gitarre und Akkordsymbole",
        },
        {
          "id": "kp-generalbass",
          "introDu": "Der Generalbass ist eine Kurzschrift für Begleiter: Eine bezifferte Bassnote sagt, welche Töne darüber klingen. Und alles denkt in Stufen — Tonika, Subdominante, Dominante.",
          "title": "Generalbass und Stufen",
        },
        {
          "id": "kp-partitur",
          "introDu": "Wie ist eine Braille-Partitur aufgebaut? Taktzahlen stehen ohne Zahlzeichen am Rand (der Auftakt ist Takt 0), und die Stimmen liegen abschnittsweise übereinander. So findet man sich zurecht.",
          "title": "Partitur und Druckbild",
        },
        {
          "id": "kp-orchester",
          "introDu": "Instrumente lassen sich in Familien ordnen: Saitenklinger, Luftklinger, Fellklinger und Selbstklinger — nach dem, was den Klang macht. Hör hin und ordne die Klangfarben zu.",
          "title": "Bläser, Schlagwerk & Co.",
        },
      ],
      "key": "instrumente",
      "nr": 8,
      "title": "Instrumentenkunde",
    },
    {
      "blurb": "Echte Lieder: anhören, in Braille lesen, mit Ausdruck spielen und aus dem Gedächtnis nachspielen.",
      "etappen": [
        {
          "id": "kp14",
          "introDu": "Jetzt spielst du richtige Musik! Such dir ein Lied aus — anhören, in Braille lesen, aus dem Gedächtnis schreiben. Erst lesen, dann im Kopf hören, dann spielen.",
          "title": "Lieder-Werkstatt",
        },
        {
          "id": "kp-lieder2",
          "introDu": "Dieselben Lieder, jetzt mit Gefühl: gebunden oder kurz, leise oder laut. Hör den Unterschied zwischen der trockenen und der ausdrucksvollen Fassung — und schreib die Zeilen mit.",
          "title": "Lieder mit Ausdruck",
        },
        {
          "id": "kp-lesekonzert",
          "introDu": "Die Königsdisziplin: Lies eine Braille-Zeile, ohne sie zu hören, präg sie dir ein — und spiel sie dann aus dem Gedächtnis nach. Genau so spielt man vom Blatt, denn beim Spielen kann man nicht lesen.",
          "title": "Lese-Konzert",
        },
        {
          "id": "kp-liederquiz",
          "introDu": "Erkennst du ein Lied allein an seiner Braille-Zeile — ohne einen einzigen Ton? Oder findest du zur gehörten Melodie das richtige Lied? Das ist stilles Lesen mit dem inneren Ohr.",
          "title": "Lieder-Quiz",
        },
      ],
      "key": "buehne",
      "nr": 9,
      "title": "Lieder-Bühne",
    },
  ],
}
`;

