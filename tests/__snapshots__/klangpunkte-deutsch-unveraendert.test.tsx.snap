exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp13 im Runner (erste Aufgabe) > runner-kp13 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-write-Schreib das Braille-Taktwiederholungszeichen (den ganzen Takt noch einmal spielen)."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Musik wiederholt sich gern — und Braille kürzt schlau: ein eigenes Zeichen sagt: diesen Takt noch einmal! Dazu: Wiederholungsklammern und der Schlussstrich.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Schreib das Braille-Taktwiederholungszeichen (den ganzen Takt noch einmal spielen).<span class="text-ink-muted"></span></p><div role="application" aria-label="Braille-Eingabe: f d s und j k l sind die Punkte, Leertaste der Taktstrich. Zelle 1 von 1. Umschalt gedrückt halten zeigt und sagt die Tasten der Zelle." aria-keyshortcuts="Shift" data-feld="notenschreiben" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><p class="text-sm text-ink-muted" aria-hidden="true">Schreib mit <span class="font-mono">f d s · j k l</span> — Zelle 1 von 1 · <kbd class="rounded border border-hairline px-1">⇧ Umschalt</kbd> zeigt die Zelle</p><div class="flex flex-wrap items-center gap-1.5" aria-hidden="true"><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp14 im Runner (erste Aufgabe) > runner-kp14 1`] = `"<div class="card space-y-5 p-5"><p class="text-sm text-ink-muted">Jetzt spielst du richtige Musik! Such dir ein Lied aus — anhören, in Braille lesen, aus dem Gedächtnis schreiben. Erst lesen, dann im Kopf hören, dann spielen.</p><fieldset class="space-y-2"><legend class="text-sm font-semibold text-ink">🧒 Kinderlieder</legend><div class="flex flex-wrap gap-2"><button type="button" class="btn-secondary btn-toggle" title="Volkslied (trad., 19. Jh.) — Referenzstück des BBI-Workshops">Hänschen klein</button><button type="button" class="btn-secondary btn-toggle" title="Volkslied (trad.)">Alle meine Entchen</button><button type="button" class="btn-secondary btn-toggle" title="Volkslied (trad., Text Hoffmann von Fallersleben)">Kuckuck, Kuckuck, ruft's aus dem Wald</button><button type="button" class="btn-secondary btn-toggle" title="Volkslied (trad., Frère Jacques) — als Kanon singbar">Bruder Jakob</button><button type="button" class="btn-secondary btn-toggle" title="Volkslied (trad., Text Hoffmann von Fallersleben)">Summ, summ, summ</button><button type="button" class="btn-secondary btn-toggle" title="Volkslied (trad.)">Fuchs, du hast die Gans gestohlen</button><button type="button" class="btn-secondary btn-toggle" title="Volkslied (trad., Melodie C. G. Hering)">Hopp, hopp, hopp</button><button type="button" class="btn-secondary btn-toggle" title="Österreichisches Volkslied (Text A. Reidinger, Melodie trad.)">Es wird scho glei dumpa</button></div></fieldset><fieldset class="space-y-2"><legend class="text-sm font-semibold text-ink">🎼 Klassik &amp; Evergreens</legend><div class="flex flex-wrap gap-2"><button type="button" class="btn-secondary btn-toggle" title="L. v. Beethoven, 9. Sinfonie (1824), Chorthema — Europahymne">Ode an die Freude (Beethoven)</button><button type="button" class="btn-secondary btn-toggle" title="W. A. Mozart, KV 525 (1787), 1. Satz, Kopfthema (vereinfacht)">Eine kleine Nachtmusik (Mozart)</button><button type="button" class="btn-secondary btn-toggle" title="L. v. Beethoven, WoO 59 (1810), Anfangsthema — mit dem berühmten dis!">Für Elise (Beethoven)</button><button type="button" class="btn-secondary btn-toggle" title="Johann Strauss II, op. 314 (1867), Walzer Nr. 1, Hauptthema">An der schönen blauen Donau (Strauss)</button><button type="button" class="btn-secondary btn-toggle" title="E. Grieg, Peer-Gynt-Suite Nr. 1, op. 46 (1875), Anfangsthema">Morgenstimmung (Grieg)</button><button type="button" class="btn-secondary btn-toggle" title="Gospel (trad., USA)">Oh When the Saints</button><button type="button" class="btn-secondary btn-toggle" title="Hymne (trad., Melodie New Britain) — komplett pentatonisch">Amazing Grace</button><button type="button" class="btn-secondary btn-toggle" title="England (trad., 16. Jh.)">Greensleeves</button><button type="button" class="btn-secondary btn-toggle" title="Schottland (trad., Text R. Burns) — das Silvesterlied">Auld Lang Syne</button><button type="button" class="btn-secondary btn-toggle" title="USA (trad. Ballade; hier die dokumentierte Volksfassung, nicht das 1964er-Arrangement)">House of the Rising Sun</button></div></fieldset></div>"`;

