        {
          "key": "oct:4",
          "spoken": "Oktavzeichen eingestrichene Oktave",
        },
        {
          "key": "oct:5",
          "spoken": "Oktavzeichen zweigestrichene Oktave",
        },
      ],
      "items": [Function],
      "legend": "",
