  "etappen": [
    {
      "id": "kp1",
      "introDu": "Bevor wir Noten fühlen, üben wir das Wichtigste: genau hinhören. Höher oder tiefer, rauf oder runter — dein Ohr entscheidet.",
      "introSie": "Musik-Readiness vor der Schrift (Taesch, Phase One): auditive Diskrimination von Tonhöhe und Richtung als Fundament des Notenlesens.",
      "introducedUnits": [],
      "items": [Function],
      "legend": "",
      "levelId": "kp1",
      "masteryGate": {
        "minAcc": 0.9,
        "minAttempts": 12,
        "patience": 0,
      },
      "system": "basis",
      "title": "Hoch oder tief? — Ohren auf",
    },
    {
      "id": "kp2",
      "introDu": "Musik hat einen Herzschlag. Hör das Muster aus langen und kurzen Tönen und klopf es mit der Leertaste nach.",
      "introSie": "Rhythmische Reproduktion vor der Symbolebene (RNIB: eine Hand liest, die andere klopft — hier als Vorform mit der Leertaste).",
      "introducedUnits": [],
      "items": [Function],
      "legend": "",
      "levelId": "kp2",
      "masteryGate": {
        "minAcc": 0.9,
        "minAttempts": 12,
        "patience": 0,
      },
      "system": "basis",
      "title": "Klopf den Rhythmus",
    },
    {
      "id": "kp3",
      "introDu": "Überraschung: Die Noten kennst du schon! c d e f g a h sind die Braille-Buchstaben d e f g h i j — das Alphabet, einen Schritt weitergerückt. Die Grundform ist die Achtelnote.",
      "introSie": "Kern der Dekaden-Analogie (Workshop Schmid/BBI): Tonhöhen c–h = Buchstaben d–j; die Achtelform als zeichenlogische Grundform (Krolick Par. 1-1).",
      "introducedUnits": [
        {
          "key": "n:c:achtel",
          "spoken": "c als Achtelnote",
        },
        {
          "key": "n:d:achtel",
          "spoken": "d als Achtelnote",
        },
        {
          "key": "n:e:achtel",
          "spoken": "e als Achtelnote",
        },
        {
          "key": "n:f:achtel",
          "spoken": "f als Achtelnote",
        },
        {
          "key": "n:g:achtel",
          "spoken": "g als Achtelnote",
