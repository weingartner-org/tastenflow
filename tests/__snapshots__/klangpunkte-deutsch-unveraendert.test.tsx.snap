t p-0 text-left font-semibold tracking-tight text-ink hover:underline underline-offset-4"><span class="sr-only sm:not-sr-only ">Klangpunkte</span></button><span data-hinweis-anker="tipp-r5" hidden=""></span></span></h1></div><nav aria-label="Werkzeuge" class="flex min-w-0 flex-wrap items-center justify-end gap-2"><span class="relative inline-flex"><button type="button" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border text-sm font-semibold transition-colors border-hairline bg-surface-raised text-ink hover:bg-surface-sunken" aria-pressed="false" aria-keyshortcuts="Alt+T" aria-label="Kurztasten - Tastenkürzel-Liste (Alt + T)" data-kopf-text="Kurztasten - Tastenkürzel-Liste" aria-describedby="tipp-r6"><span aria-hidden="true" class="font-mono text-xs font-semibold">Alt</span></button><span data-hinweis-anker="tipp-r6" hidden=""></span></span><span class="relative inline-flex"><button type="button" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border text-sm font-semibold transition-colors border-hairline bg-surface-raised text-ink hover:bg-surface-sunken" aria-keyshortcuts="Alt+H" aria-label="Hilfe in einfacher Sprache (Alt + H)" data-kopf-text="Hilfe in einfacher Sprache" aria-describedby="tipp-r7"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[22px] w-[22px]" aria-hidden="true" focusable="false"><path d="M7.64 7.5a4.5 4.5 0 0 1 8.75 1.5c0 3-4.5 4.5-4.5 4.5"></path><line x1="12" y1="19.5" x2="12.01" y2="19.5"></line></svg></button><span data-hinweis-anker="tipp-r7" hidden=""></span></span><span class="relative inline-flex"><button type="button" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border text-sm font-semibold transition-colors border-hairline bg-surface-raised text-ink hover:bg-surface-sunken" aria-keyshortcuts="Alt+J" aria-label="Konto (Alt + J)" data-kopf-text="Konto" aria-describedby="tipp-r8"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[22px] w-[22px]" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 21v-1.5a5.5 5.5 0 0 1 5.5-5.5h4a5.5 5.5 0 0 1 5.5 5.5V21"></path></svg></button><span data-hinweis-anker="tipp-r8" hidden=""></span></span><span aria-hidden="true" class="mx-0.5 h-6 w-px shrink-0 self-center bg-hairline"></span><span class="relative inline-flex"><div class="relative inline-flex"><button type="button" aria-expanded="false" aria-controls="r1" aria-keyshortcuts="Alt+K" aria-describedby="tipp-r9" aria-label="Farben und Kontrast (Alt + K)" data-kopf-text="Farben und Kontrast" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border text-sm font-semibold transition-colors border-hairline bg-surface-raised text-ink hover:bg-surface-sunken"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[22px] w-[22px]" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor"></path></svg></button></div><span data-hinweis-anker="tipp-r9" hidden=""></span></span><span class="relative inline-flex"><div class="relative inline-flex"><button type="button" aria-expanded="false" aria-controls="r2" aria-describedby="tipp-ra" aria-label="Klang und Vorlesen" data-kopf-text="Klang und Vorlesen" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border text-sm font-semibold transition-colors border-hairline bg-surface-raised text-ink hover:bg-surface-sunken"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[22px] w-[22px]" aria-hidden="true" focusable="false"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg></button></div><span data-hinweis-anker="tipp-ra" hidden=""></span></span></nav></header></div><div class="blatt-flaeche mt-2"><div class="not-prose space-y-5"><div id="kp-live-task" aria-live="assertive" aria-atomic="true" class="sr-only"></div><div id="kp-live-status" role="status" aria-live="polite" aria-atomic="true" class="sr-only"></div><div id="kp-live-alert" role="alert" aria-live="assertive" aria-atomic="true" class="sr-only"></div><div class="card p-4"><div class="flex flex-wrap items-center gap-x-4 gap-y-3"><div class="flex items-center gap-2"><div class="flex shrink-0 flex-col items-center gap-0.5" role="img" aria-label="Rang 1 — noch 100 XP bis zum nächsten." title="Rang 1 — noch 100 XP bis zum nächsten."><div class="relative" style="width: 46px; height: 46px;"><svg width="46" height="46" viewBox="0 0 46 46" class="-rotate-90"><circle cx="23" cy="23" r="21" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="4"></circle><circle cx="23" cy="23" r="21" fill="none" stroke="rgb(var(--c-accent))" stroke-width="4" stroke-linecap="round" stroke-dasharray="131.94689145077132" stroke-dashoffset="131.94689145077132" class="transition-all duration-500"></circle></svg><span class="absolute inset-0 flex items-center justify-center text-base font-bold text-ink">1</span></div><span class="text-[10px] font-medium uppercase tracking-wide text-ink-muted">Rang</span></div><span class="text-xs leading-tight text-ink-muted"><span role="img" title="0 XP — 2 je richtige Antwort, 30 je Kapitel." aria-label="0 XP — 2 je richtige Antwort, 30 je Kapitel.">0 XP</span><br><span role="img" title="0 von 183 Sternen — bis zu 3 je Kapitel." aria-label="0 von 183 Sternen — bis zu 3 je Kapitel.">0 ★</span></span></div><div class="flex flex-wrap items-center gap-x-3 gap-y-2 sm:ml-auto"><p class="text-sm font-semibold text-ink">63 Kapitel in 9 Klangwelten - alle frei wählbar</p></div></div></div><div class="card p-4"><div class="flex flex-wrap items-center gap-2"><button type="button" aria-pressed="true" aria-keyshortcuts="Alt+U" class="btn-primary btn-toggle" title="Alle Klangwelten und Kapitel mit deinem Sterne-Stand (Alt + U)"><span aria-hidden="true">🗺</span> Kapitelwahl</button><button type="button" aria-pressed="false" aria-keyshortcuts="Alt+L" class="btn-secondary btn-toggle" title="Liste aller Noten-Zeichen, sortiert nach deinem Lernweg (Alt + L)"><span aria-hidden="true">📖</span> Zeichenliste</button></div></div><div class="space-y-5"><h2 tabindex="-1" class="m-0 text-lg font-semibold text-ink outline-none">Kapitelwahl — such dir aus, was du üben willst</h2><section class="card p-4" aria-labelledby="kw-mix-h"><div class="flex flex-wrap items-center justify-between gap-3"><div class="min-w-0"><h3 id="kw-mix-h" class="m-0 text-base font-semibold text-ink"><span aria-hidden="true">🎲 </span>Tages-Mix</h3><p class="m-0 mt-0.5 text-sm text-ink-muted">Fünf Minuten bunt gemischt — Aufgaben quer durch deine gemeisterten Kapitel, ohne Sterne, nur zum Wachhalten.</p></div><p class="m-0 max-w-[16rem] text-xs text-ink-muted">Meistere erst ein paar Kapitel (mindestens 3), dann gibt es hier deinen Tages-Mix. Bisher: 0.</p></div></section><section class="card p-4" aria-labelledby="kw-h-ohren"><h3 id="kw-h-ohren" class="m-0 text-base font-semibold text-ink">Klangwelt 1: Ohrenspitzer</h3><p class="m-0 mt-0.5 text-sm text-ink-muted">Erst hören, dann nachspielen: Puls, Tonhöhen, Klangfarben und Echo mit den Ohren fangen.</p><p class="m-0 mt-1 text-xs text-ink-muted">0 von 8 Kapiteln gemeistert · 0 von 24 Sternen</p><ul class="m-0 mt-3 grid list-none gap-2 p-0 sm:grid-cols-2"><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 1: Hoch oder tief? — Ohren auf</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 2: Klopf den Rhythmus</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 3: Puls-Fänger</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 4: Lang oder kurz?</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 5: Laut und leise</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 6: Welches Instrument?</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 7: Echo-Spiel</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 8: Melodie-Memory</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li></ul></section><section class="card p-4" aria-labelledby="kw-h-werkstatt"><h3 id="kw-h-werkstatt" class="m-0 text-base font-semibold text-ink">Klangwelt 2: Notenwerkstatt</h3><p class="m-0 mt-0.5 text-sm text-ink-muted">Noten, Werte, Pausen und Takt — die Grundzeichen der Braille-Noten.</p><p class="m-0 mt-1 text-xs text-ink-muted">0 von 9 Kapiteln gemeistert · 0 von 27 Sternen</p><ul class="m-0 mt-3 grid list-none gap-2 p-0 sm:grid-cols-2"><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 1: Die Noten sind alte Bekannte</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 2: Erste Melodien</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 3: Viertelnoten — Punkt 6 dazu</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 4: Halbe und Ganze</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 5: Pausen und Takt</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 6: Punktierte Noten</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 7: Der Haltebogen</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 8: Auftakt und halbe Takte</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 9: Lange Stille</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</span></button></li></ul></section><section class="card p-4" aria-labelledby="kw-h-lage"><h3 id="kw-h-lage" class="m-0 text-base font-semibold text-ink">Klangwelt 3: Kreuz &amp; Lage</h3><p class="m-0 mt-0.5 text-sm text-ink-muted">Versetzungszeichen, Tonarten, Oktavzeichen — und flinke kleine Werte.</p><p class="m-0 mt-1 text-xs text-ink-muted">0 von 9 Kapiteln gemeistert · 0 von 27 Sternen</p><ul class="m-0 mt-3 grid list-none gap-2 p-0 sm:grid-cols-2"><li><button type="button" class="card flex w-full items-center justify-between gap-3 border border-hairline bg-surface-raised px-3 py-2.5 text-left text-sm hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-medium text-ink">Kapitel 1: Kreuz, Be und Auflösung</span><span aria-hidden="true" class="shrink-0 tracking-wide text-amber-500">☆☆☆</span><span class="sr-only">— noch nicht gemeistert.</spa