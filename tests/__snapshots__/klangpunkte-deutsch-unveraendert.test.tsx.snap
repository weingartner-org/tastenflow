exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp10 im Runner (erste Aufgabe) > runner-kp10 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-In welcher Lage klingt das?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">In Braille gibt es keinen Notenschlüssel! Stattdessen sagen Oktavzeichen, WIE hoch eine Note liegt. Die erste Note eines Stücks bekommt immer eins.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">In welcher Lage klingt das?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Tief (kleine Oktave)</button><button type="button" class="btn-secondary btn-toggle">2. Mittel (eingestrichen)</button><button type="button" class="btn-secondary btn-toggle">3. Hoch (zweigestrichen)</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp11 im Runner (erste Aufgabe) > runner-kp11 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Erste Note: d, zweigestrichene Oktave. Danach: f, dreigestrichene Oktave. Braucht die zweite Note ein Oktavzeichen?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Wann braucht eine Note ein Oktavzeichen? Sekunde und Terz: nie. Quarte und Quinte: nur bei Oktavwechsel. Ab der Sexte: immer. Werde zum Oktav-Detektiv!</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Erste Note: d, zweigestrichene Oktave. Danach: f, dreigestrichene Oktave. Braucht die zweite Note ein Oktavzeichen?<span class="text-ink-muted"></span></p><div class="rounded-xl border border-hairline bg-surface-raised p-3"><svg aria-hidden="true" viewBox="0 0 120 127" style="width: 100%; max-width: 264px; height: auto; display: block;"><line x1="8" y1="26" x2="112" y2="26" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="36" x2="112" y2="36" stroke="rgb(var