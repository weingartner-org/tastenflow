irline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle></svg><svg role="img" aria-label="Punkte 1, 4, 5, 6" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle></svg></div><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Es wird scho glei dumpa</button><button type="button" class="btn-secondary btn-toggle">2. House of the Rising Sun</button><button type="button" class="btn-secondary btn-toggle">3. Hopp, hopp, hopp</button><button type="button" class="btn-secondary btn-toggle">4. Bruder Jakob</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-melodie-memory im Runner (erste Aufgabe) > runner-kp-melodie-memory 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-play-Melodie-Memory: Ich spiele eine Tonfolge, du spielst sie nach (D F G H J K L = c d e f g a h). Schaffst du es, kommt ein Ton dazu — wie weit kommst du?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Wie beim Memory, nur mit Tönen: Schaffst du die Folge, kommt ein Ton dazu. Wie weit kommst du? Ein Gedächtnis-Spiel fürs innere Ohr.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Melodie-Memory: Ich spiele eine Tonfolge, du spielst sie nach (D F G H J K L = c d e f g a h). Schaffst du es, kommt ein Ton dazu — wie weit kommst du?<span class="text-ink-muted"></span></p><div role="application" aria-label="Nachspiel-Klaviatur: D F G H J K L sind c d e f g a h. Pfeil rauf und runter wechselt die Oktave. Aktuelle Länge 2 Töne. " data-feld="spielen" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><p class="text-sm text-ink-muted" aria-hidden="true">Spiel nach mit <span class="font-mono">D F G H J K L</span> — Länge 2 · <kbd class="rounded border border-hairline px-1">↑ ↓</kbd> Oktave (eingestrichene Oktave)</p><div class="flex flex-wrap gap-1.5" aria-hidden="true"><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">D</span><span class="text-xs text-ink-muted">c</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">F</span><span class="text-xs text-ink-muted">d</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">G</span><span class="text-xs text-ink-muted">e</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">H</span><span class="text-xs text-ink-muted">f</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">J</span><span class="text-xs text-ink-muted">g</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">K</span><span class="text-xs text-ink-muted">a</span></button><button type="button" tabindex="-1" class="flex min-w-[3rem] flex-col items-center rounded-lg border border-hairline bg-surface-raised px-3 py-2 hover:bg-surface-sunken focus-visible:outline focus-visible:outline-[4.5px] focus-visible:outline-offset-2 focus-visible:outline-accent"><span class="font-mono text-sm font-semibold text-ink">L</span><span class="text-xs text-ink-muted">h</span></button></div><div class="flex gap-1.5" aria-hidden="true"><button type="button" tabindex="-1" class="btn-secondary btn-toggle">Oktave rauf</button><button type="button" tabindex="-1" class="btn-secondary btn-toggle">Oktave runter</button></div></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-melodiediktat im Runner (erste Aufgabe) > runner-kp-melodiediktat 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-write-Melodie-Diktat: Der Startton ist a. Hör die 3 Töne und schreib sie — sie gehen in kleinen Schritten. Anhören so oft du magst."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Die Königsübung: Ich spiele eine kleine Melodie, du schreibst sie auf. Sie geht in kleinen Schritten los, der Startton wird immer gesagt, und du darfst so oft anhören, wie du willst.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Melodie-Diktat: Der Startton ist a. Hör die 3 Töne und schreib sie — sie gehen in kleinen Schritten. Anhören so oft du magst.<span class="text-ink-muted"></span></p><div role="application" aria-label="Braille-Eingabe: f d s und j k l sind die Punkte, Leertaste der Taktstrich. Zelle 1 von 4. Umschalt gedrückt halten zeigt und sagt die Tasten der Zelle." aria-keyshortcuts="Shift" data-feld="notenschreiben" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><button type="button" class="btn-primary"><span aria-hidden="true">🔊</span> Nochmal anhören</button><p class="text-sm text-ink-muted" aria-hidden="true">Hör so oft du willst — es zählt nicht als Fehler. Schreib dann Zelle für Zelle, was du gehört hast.</p><div class="flex flex-wrap items-center gap-1.5" aria-hidden="true"><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-orchester im Runner (erste Aufgabe) > runner-kp-orchester 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Hör das kurze Motiv — zu welcher Instrumentenfamilie gehört dieser Klang?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Instrumente lassen sich in Familien ordnen: Saitenklinger, Luftklinger, Fellklinger und Selbstklinger — nach dem, was den Klang macht. Hör hin und ordne die Klangfarben zu.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Hör das kurze Motiv — zu welcher Instrumentenfamilie gehört dieser Klang?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Saitenklinger — gezupft oder angeschlagen</button><button type="button" class="btn-secondary btn-toggle">2. Luftklinger — geblasen</button><button type="button" class="btn-secondary btn-toggle">3. Fellklinger — geschlagen</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-partitur im Runner (erste Aufgabe) > runner-kp-partitur 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Ein Stück beginnt mit einem Auftakt. Welche Nummer trägt dieser erste, unvollständige Takt?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Wie ist eine Braille-Partitur aufgebaut? Taktzahlen stehen ohne Zahlzeichen am Rand (der Auftakt ist Takt 0), und die Stimmen liegen abschnittsweise übereinander. So findet man sich zurecht.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Ein Stück beginnt mit einem Auftakt. Welche Nummer trägt dieser erste, unvollständige Takt?<span class="text-ink-muted"></span></p><div class="flex flex-wrap items-center gap-1" aria-hidden="true"><svg role="img" aria-label="Punkte 2, 4, 5" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Takt 0</button><button type="button" class="btn-secondary btn-toggle">2. Takt 1</button><button type="button" class="btn-secondary btn-toggle">3. Takt 2</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-pausen2 im Runner (erste Aufgabe) > runner-kp-pausen2 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-write-Schreib: 7 Takte Pause — Zahlzeichen, die 7, dann die ganze Pause."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Wenn viele Takte still sind, zählt Braille schlau: bis drei leere Takte einfach die ganze Pause mehrmals — ab vier steht die Anzahl als Zahl davor.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Schreib: 7 Takte Pause — Zahlzeichen, die 7, dann die ganze Pause.<span class="text-ink-muted"></span></p><div role="application" aria-label="Braille-Eingabe: f d s und j k l sind die Punkte, Leertaste der Taktstrich. Zelle 1 von 3. Umschalt gedrückt halten zeigt und sagt die Tasten der Zelle." aria-keyshortcuts="Shift" data-feld="notenschreiben" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><p class="text-sm text-ink-muted" aria-hidden="true">Schreib mit <span class="font-mono">f d s · j k l</span> — Zelle 1 von 3 · <kbd class="rounded border border-hairline px-1">⇧ Umschalt</kbd> zeigt die Zelle</p><div class="flex flex-wrap items-center gap-1.5" aria-hidden="true"><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-puls im Runner (erste Aufgabe) > runner-kp-puls 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-tap-Fühl den Grundschlag und klopf ihn gleichmäßig mit der Leertaste mit — 8 Schläge lang."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Jede Musik hat einen Herzschlag — den Grundschlag. Fang ihn: klopf ihn gleichmäßig mit, hör die betonten Schläge und unterscheide den Marsch (Zweier) vom Walzer (Dreier).</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Fühl den Grundschlag und klopf ihn gleichmäßig mit der Leertaste mit — 8 Schläge lang.<span class="text-ink-muted"></span></p><div role="application" aria-label="Rhythmus klopfen: Leertaste. Bisher 0 Schläge." data-feld="klopfen" tabindex="0" class="rounded-xl border-2 border-dashed border-hairline p-6 text-center focus:border-accent"><p class="text-sm text-ink-muted" aria-hidden="true">Klopf hier mit der <strong>Leertaste</strong> — 0 von 8 Schlägen</p><button type="button" class="btn-primary btn-toggle mt-3">Klopfen (0 von 8)</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-quintenzirkel im Runner (erste Aufgabe) > runner-kp-quintenzirkel 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Station: Es-Dur. Wie viele Bes hat diese Tonart?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Eine Rallye durch die Tonarten: Wie viele Kreuze hat G-Dur? Welche Tonart hat zwei Bes? Lern die Vorzeichen bis vier Kreuze und vier Bes — vorwärts und rückwärts.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Station: Es-Dur. Wie viele Bes hat diese Tonart?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. 2</button><button type="button" class="btn-secondary btn-toggle">2. 1</button><button type="button" class="btn-secondary btn-toggle">3. 4</button><button type="button" class="btn-secondary btn-toggle">4. 3</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-rhythmusdiktat im Runner (erste Aufgabe) > runner-kp-rhythmusdiktat 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-write-Rhythmus-Diktat: Ich klopfe einen Takt auf dem Ton g. Schreib die Werte, die du hörst. Startton ist g. Anhören so oft du willst."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Ich klopfe einen Takt — du schreibst die Werte auf. Nur der Rhythmus zählt, die Tonhöhe bleibt gleich. Und umgekehrt: lies einen Rhythmus vom Blatt und klopf ihn nach.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Rhythmus-Diktat: Ich klopfe einen Takt auf dem Ton g. Schreib die Werte, die du hörst. Startton ist g. Anhören so oft du willst.<span class="text-ink-muted"></span></p><div role="application" aria-label="Braille-Eingabe: f d s und j k l sind die Punkte, Leertaste der Taktstrich. Zelle 1 von 3. Umschalt gedrückt halten zeigt und sagt die Tasten der Zelle." aria-keyshortcuts="Shift" data-feld="notenschreiben" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><button type="button" class="btn-primary"><span aria-hidden="true">🔊</span> Nochmal anhören</button><p class="text-sm text-ink-muted" aria-hidden="true">Hör so oft du willst — es zählt nicht als Fehler. Schreib dann Zelle für Zelle, was du gehört hast.</p><div class="flex flex-wrap items-center gap-1.5" aria-hidden="true"><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-schluessel im Runner (erste Aufgabe) > runner-kp-schluessel 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Welcher Notenschlüssel steht hier (drei Zellen)?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Violinschlüssel und Bassschlüssel gibt es auch in Braille — aber nur als Info über das Druckbild! Die Lage sagen dir immer die Oktavzeichen. Gut zu kennen für Gespräche mit sehenden Musiker:innen und für MuseScore.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Welcher Notenschlüssel steht hier (drei Zellen)?<span class="text-ink-muted"></span></p><div class="flex flex-wrap items-center gap-1" aria-hidden="true"><svg role="img" aria-label="Punkte 3, 4, 5" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-wid