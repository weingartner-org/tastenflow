exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp12 im Runner (erste Aufgabe) > runner-kp12 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Im 2/4-Takt stehen ACHT gleiche Zellen hintereinander. Ganze Noten oder Sechzehntel?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Ein Geheimnis der Braille-Noten: Dieselbe Zelle kann ganze Note ODER Sechzehntel bedeuten! Der Takt verrät dir, was gemeint ist. Detektivarbeit!</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Im 2/4-Takt stehen ACHT gleiche Zellen hintereinander. Ganze Noten oder Sechzehntel?<span class="text-ink-muted"></span></p><div class="flex flex-wrap items-center gap-1" aria-hidden="true"><svg role="img" aria-label="Punkte 3, 4, 5, 6" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opac