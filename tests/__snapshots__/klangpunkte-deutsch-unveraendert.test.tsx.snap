exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-baumeister im Runner (erste Aufgabe) > runner-kp-baumeister 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-build-Bau einen vollen 3/4-Takt: schreib Noten und Pausen mit f d s j k l, bis die Schläge genau 3 ergeben. Enter prüft."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Bau eigene Takte: Schreib Noten und Pausen, bis die Schläge genau zur Taktart passen. Zu wenig? Zu viel? Dein Takt sagt es dir — und wenn er stimmt, klingt er.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Bau einen vollen 3/4-Takt: schreib Noten und Pausen mit f d s j k l, bis die Schläge genau 3 ergeben. Enter prüft.<span class="text-ink-muted"></span></p><div role="application" aria-label="Takt-Baumeister: Schreib mit f d s j k l Noten oder Pausen; jede klingt sofort. Rücktaste löscht die letzte Zelle, Enter prüft den Takt. Bisher 0 Zellen." aria-keyshortcuts="Enter Backspace" data-feld="takt" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><p class="text-sm text-ink-muted" aria-hidden="true">Bau den Takt mit <span class="font-mono">f d s · j k l</span> — jede Note/Pause klingt. <kbd class="rounded border border-hairline px-1">⌫</kbd> löscht, <kbd class="rounded border border-hairline px-1">⏎ Enter</kbd> prüft. Taktart 3/4.</p><div class="flex flex-wrap items-center gap-1.5" aria-hidden="true"><span class="text-sm text-ink-muted">Noch leer — leg los.</span></div><div class="flex gap-1.5" aria-hidden="true"><button type="button" tabindex="-1" class="btn-primary btn-toggle">Takt prüfen (Enter)</button><button type="button" tabindex="-1" class="btn-secondary btn-toggle">Löschen (⌫)</button></div></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-bindebogen im Runner (erste Aufgabe) > runner-kp-bindebogen 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Wurde das Motiv gebunden (legato) oder getrennt gespielt?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Der Bindebogen sagt: spiel diese Töne weich gebunden, legato. Nicht zu verwechseln mit dem Haltebogen! Der bindet gleiche Töne zu EINEM — der Bindebogen verbindet verschiedene.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Wurde das Motiv gebunden (legato) oder getrennt gespielt?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Gebunden — legato</button><button type="button" class="btn-secondary btn-toggle">2. Getrennt</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-braillerepeats im Runner (erste Aufgabe) > runner-kp-braillerepeats 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Ein Takt, dann Wiederholungszeichen. Wie oft erklingt der Takt insgesamt?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Braille ist schlau: Statt einen gleichen Takt noch einmal zu schreiben, setzt es das Simile-Zeichen — und mit einer Zahl dahinter sagt es sogar, wie oft. Aber Achtung: nicht auf dem ersten Schlag einer Zeile!</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Ein Takt, dann Wiederholungszeichen. Wie oft erklingt der Takt insgesamt?<span class="text-ink-muted"></span></p><div class="flex flex-wrap items-center gap-1" aria-hidden="true"><svg role="img" aria-label="Punkte 1, 2, 5, 6" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="10" fill="rgb(var(--c-ink)