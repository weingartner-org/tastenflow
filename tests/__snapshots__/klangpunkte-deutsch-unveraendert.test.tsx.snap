r="2" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="116" cy="109.5" r="0.9" fill="transparent" stroke="rgb(var(--c-ink) / 0.35)" stroke-width="0.7"></circle><circle cx="116" cy="115.5" r="0.9" fill="transparent" stroke="rgb(var(--c-ink) / 0.35)" stroke-width="0.7"></circle><circle cx="122" cy="103.5" r="2" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="122" cy="109.5" r="2" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="122" cy="115.5" r="2" fill="rgb(var(--c-danger))" stroke="none" stroke-width="0"></circle></g></g></svg></div></div></div></div><p class="mt-2 text-center text-xs text-ink-muted" aria-hidden="true"><kbd class="rounded border border-hairline px-1">Alt + Q</kbd> - eine Hand allein groß sehen &amp; hören (gerade: beide Hände)</p></div><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. 2 Töne</button><button type="button" class="btn-secondary btn-toggle">2. 3 Töne</button><button type="button" class="btn-secondary btn-toggle">3. 4 Töne</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-komponier im Runner (erste Aufgabe) > runner-kp-komponier 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-sandbox-Komponier-Werkstatt: Schreib frei mit f d s j k l, hör dir dein Werk an und speichere es (bis zu 5). Die Werkstatt ist besucht, sobald du ein Werk gespeichert hast."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Dein eigenes Blatt: Schreib frei, hör dir dein Werk an und speichere es. Bis zu fünf Werke passen ins Regal. Die Werkstatt ist besucht, sobald du das erste gespeichert hast.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Komponier-Werkstatt: Schreib frei mit f d s j k l, hör dir dein Werk an und speichere es (bis zu 5). Die Werkstatt ist besucht, sobald du ein Werk gespeichert hast.<span class="text-ink-muted"></span></p><div role="application" aria-label="Komponier-Werkstatt: Schreib frei mit f d s j k l, Leertaste ist der Taktstrich. Anhören, Löschen und Speichern über die Knöpfe. Bisher 0 Zellen, 0 von 5 Werken gespeichert." data-feld="werkstatt" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><p class="text-sm text-ink-muted" aria-hidden="true">Schreib frei mit <span class="font-mono">f d s · j k l</span> — Leertaste = Taktstrich, <kbd class="rounded border border-hairline px-1">⌫</kbd> löscht die letzte Zelle.</p><div class="flex flex-wrap items-center gap-1.5" aria-hidden="true"><span class="text-sm text-ink-muted">Leeres Blatt — komponier drauflos.</span></div><div class="flex flex-wrap items-center gap-1.5"><button type="button" class="btn-secondary btn-toggle"><span aria-hidden="true">▶</span> Anhören</button><button type="button" class="btn-secondary btn-toggle">Löschen</button><input type="text" placeholder="Name für dein Werk" aria-label="Name für dein Werk" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink" maxlength="40" value=""><button type="button" class="btn-primary btn-toggle"><span aria-hidden="true">💾</span> Speichern</button></div></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-lauschen-dauer im Runner (erste Aufgabe) > runner-kp-lauschen-dauer 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Zwei Töne nacheinander. Welcher klang länger?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Bevor du Notenwerte schreibst, hörst du sie: Welcher Ton klang länger? Wie viele Schläge dauerte er? Dein Ohr lernt Viertel, Halbe und Ganze als KLANG kennen.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Zwei Töne nacheinander. Welcher klang länger?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Der erste</button><button type="button" class="btn-secondary btn-toggle">2. Der zweite</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-lauschen-dynamik im Runner (erste Aufgabe) > runner-kp-lauschen-dynamik 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Hör die kleine Phrase: laut oder leise gespielt?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Musik lebt vom Wechsel zwischen laut und leise. Hör hin: laut oder leise? Wird es lauter oder leiser? Wo sitzt der betonte Ton? Das ist die Vorübung zur Dynamik in Braille.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Hör die kleine Phrase: laut oder leise gespielt?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Laut</button><button type="button" class="btn-secondary btn-toggle">2. Leise</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-lesekonzert im Runner (erste Aufgabe) > runner-kp-lesekonzert 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-play-Lese-Konzert: Lies die Braille-Zeile (sie wird NICHT vorgespielt!), präg sie dir ein und drück „Fertig gelesen“. Dann spiel die Töne aus dem Gedächtnis auf der Klaviatur nach."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Die Königsdisziplin: Lies eine Braille-Zeile, ohne sie zu hören, präg sie dir ein — und spiel sie dann aus dem Gedächtnis nach. Genau so spielt man vom Blatt, denn beim Spielen kann man nicht lesen.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Lese-Konzert: Lies die Braille-Zeile (sie wird NICHT vorgespielt!), präg sie dir ein und drück „Fertig gelesen“. Dann spiel die Töne aus dem Gedächtnis auf der Klaviatur nach.<span class="text-ink-muted"></span></p><div role="application" aria-label="Lese-Konzert: Lies die Braille-Zeile. Drück Enter oder „Fertig gelesen“, wenn du sie im Kopf hast." data-feld="spielen" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><div class="space-y-3"><p class="text-sm text-ink-muted" aria-hidden="true">Lies die Zeile in Braille — sie wird <strong>nicht</strong> vorgespielt. Wenn du sie im Kopf hast, <kbd class="rounded border border-hairline px-1">⏎ Enter</kbd> oder „Fertig gelesen".</p><div class="flex flex-wrap items-center gap-1" aria-hidden="true"><svg role="img" aria-label="Punkt 5" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="Punkte 1, 2, 4, 6" data-zustand="neutral" viewBox="0 0 60 90" width="37.33333333333333" height="56"><circle cx="18" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="45" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="10" fill="rgb(var(--c-ink))" stroke="none" stroke-width="0"></circle></svg><s