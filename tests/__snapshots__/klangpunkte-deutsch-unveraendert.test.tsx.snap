exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-akkorde1 im Runner (erste Aufgabe) > runner-kp-akkorde1 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Ein Dreiklang, alle Töne gleichzeitig — klingt er hell (Dur) oder dunkel (Moll)?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Drei Töne zusammen sind ein Dreiklang. Klingt er hell (Dur) oder dunkel (Moll)? Und kommen die Töne einzeln (gebrochen) oder alle zugleich? Dein Ohr lernt die Farbe der Akkorde.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Ein Dreiklang, alle Töne gleichzeitig — klingt er hell (Dur) oder dunkel (Moll)?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Dur — hell</button><button type="button" class="btn-secondary btn-toggle">2. Moll — dunkel</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-akkorde2 im Runner (erste Aufgabe) > runner-kp-akkorde2 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-write-Schreib den Dur-Dreiklang von g von OBEN: die oberste Note d, dann das Terz-Zeichen und das Quint-Zeichen abwärts."><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Einen Dreiklang schreibst du wie einen Zweiklang: die oberste Note, dann die Intervallzeichen für Terz und Quinte abwärts. Ein Ton, zwei Zeichen — fertig ist der Akkord.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Schreib den Dur-Dreiklang von g von OBEN: die oberste Note d, dann das Terz-Zeichen und das Quint-Zeichen abwärts.<span class="text-ink-muted"></span></p><div role="application" aria-label="Braille-Eingabe: f d s und j k l sind die Punkte, Leertaste der Taktstrich. Zelle 1 von 4. Umschalt gedrückt halten zeigt und sagt die Tasten der Zelle." aria-keyshortcuts="Shift" data-feld="notenschreiben" tabindex="0" class="space-y-3 rounded-xl border-2 border-dashed border-hairline p-4 focus:border-accent"><p class="text-sm text-ink-muted" aria-hidden="true">Schreib mit <span class="font-mono">f d s · j k l</span> — Zelle 1 von 4 · <kbd class="rounded border border-hairline px-1">⇧ Umschalt</kbd> zeigt die Zelle</p><div class="flex flex-wrap items-center gap-1.5" aria-hidden="true"><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg><svg role="img" aria-label="leere Zelle" data-zustand="neutral" viewBox="0 0 60 90" width="42.666666666666664" height="64"><circle cx="18" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="18" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="15" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="45" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle><circle cx="42" cy="75" r="8.5" fill="none" stroke="rgb(var(--c-hairline))" stroke-width="1.5" opacity="0.7"></circle></svg></div></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-artikulation im Runner (erste Aufgabe) > runner-kp-artikulation 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-Wie wurde das Motiv gespielt?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Wie wird ein Ton angeschlagen? Kurz abgesetzt (staccato), voll gehalten (tenuto) oder betont (Akzent)? Diese Zeichen stehen VOR der Note — nur die Fermate, die den Schluss anhält, steht danach.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Wie wurde das Motiv gespielt?<span class="text-ink-muted"></span></p><div role="group" aria-label="Antworten (auch Zifferntasten 1 bis 4)" data-feld="antworten" class="flex flex-wrap gap-2" tabindex="-1"><button type="button" class="btn-secondary btn-toggle">1. Staccato — kurz abgesetzt</button><button type="button" class="btn-secondary btn-toggle">2. Tenuto — voll ausgehalten</button><button type="button" class="btn-secondary btn-toggle">3. Akzent — betont angeschlagen</button></div></div>"`;

exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp-auftakt im Runner (erste Aufgabe) > runner-kp-auftakt 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-choice-2/4-Takt. Hör den Takt und zähl mit: Ist er vollständig?"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Nicht jeder Takt ist voll: Am Anfang darf ein kurzer Auftakt stehen, am Ende ein Resttakt. Und wenn die Zeile mitten im Takt endet, hilft der Musik-Bindestrich.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">2/4-Takt. Hör den Takt und zähl mit: Ist er vollständig?<span class="text-ink-muted"></span></p><div class="rounded-xl border border-hairline bg-surface-raised p-3"><svg aria-hidden="true" viewBox="0 0 146 127" style="width: 100%; max-width: 321.20000000000005px; height: auto; display: block;"><line x1="8" y1="26" x2="138" y2="26" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="36" x2="138" y2="36" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="46" x2="138" 