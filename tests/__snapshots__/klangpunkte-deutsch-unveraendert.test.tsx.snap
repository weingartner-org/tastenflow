exports[`Deutsch bleibt gleich - ohne Probe-Schalter > Kapitel kp9 im Runner (erste Aufgabe) > runner-kp9 1`] = `"<div class="card space-y-4 p-5" data-aufgabe="aufgabe-write-Schreib: Auflösungszeichen, dann d als Viertel. (Das Vorzeichen steht direkt VOR der Note.)"><div class="flex flex-wrap items-start justify-between gap-3"><p class="max-w-prose text-sm text-ink-muted">Manchmal rückt ein Ton einen halben Schritt: Kreuz macht höher, Be macht tiefer, das Auflösungszeichen macht es rückgängig. Das Zeichen steht direkt VOR der Note.</p><div class="flex flex-wrap items-center gap-2"><button type="button" class="btn-secondary btn-toggle" aria-keyshortcuts="Alt+W" title="Aufgabe anhören (Alt + W sagt sie zusätzlich an)"><span aria-hidden="true">▶</span> Anhören</button><select aria-label="Instrument" class="rounded-lg border border-hairline bg-surface-raised px-2 py-1.5 text-sm text-ink"><option value="klavier">Klavier</option><option value="gitarre">Gitarre</option><option value="sax">Saxophon</option><option value="floete">Querflöte</option></select><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Notennamen als do, re, mi (feste Solmisation) statt c, d, e">do-re-mi</button><button type="button" class="btn-secondary btn-toggle" aria-pressed="false" title="Rhythmussprache: zusätzlich ta, ti-ti hinter den Notenwerten ansagen">ta ti-ti</button></div></div><p class="text-base font-medium text-ink" aria-hidden="true" data-angabe="true">Schreib: Auflösungszeichen, dann d als Viertel. (Das Vorzeichen steht direkt VOR der Note.)<span class="text-ink-muted"></span></p><div class="rounded-xl border border-hairline bg-surface-raised p-3"><svg aria-hidden="true" viewBox="0 0 98 127" style="width: 100%; max-width: 215.60000000000002px; height: auto; display: block;"><line x1="8" y1="26" x2="90" y2="26" stroke="rgb(var(--c-ink))" stroke-width="0.9" opacity="0.8"></line><line x1="8" y1="36" x2="90" y2="36" stroke="rgb(var(--c-ink))" stroke-width="0.