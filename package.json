{
  "name": "tastenflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tastenflow - Zehnfingersystem lernen, barrierefrei: für Kinder mit und ohne Sehbeeinträchtigung. Mit Klassen, Lehrkraft-Konten und PocketBase-Schnittstelle.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run anker:check && vite build",
    "preview": "vite preview --port 5000",
    "typecheck": "tsc --noEmit",
    "anker:check": "tsx scripts/erzeuge-korpus-anker.mts --check",
    "test": "vitest run"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pocketbase": "^0.26.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "license": "EUPL-1.2"
}
